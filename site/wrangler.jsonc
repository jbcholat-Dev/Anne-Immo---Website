{
  // Configuration Cloudflare. Le site est construit par Astro avec l'adaptateur Cloudflare (story 10.2) :
  // les pages prérendues sont servies telles quelles, /api/*, la page de résultats du diagnostic (rendue par le serveur,
  // story 10.4) et la page de désabonnement (story 10.5) passent par worker.ts.
  // Aucun secret ici, seulement des identifiants publics. Secrets (GITHUB_TOKEN, CAL_WEBHOOK_SECRET, LIEN_SECRET, RESEND_API_KEY, TURNSTILE_SECRET_KEY, BOITE_TEST…) :
  // Cloudflare → Workers & Pages → anne-vial-tissot-site → Settings → Variables and Secrets, voir RUNBOOK.md.
  // L'indexation se règle à la construction, par la variable de build PUBLIC_INDEXATION du projet Cloudflare
  // (absente = aperçu non indexé ; « oui » = production, story 12.4). Voir .env.example.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anne-vial-tissot-site",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/diagnostic/resultats", "/desabonnement"]
  },
  // Base des leads (D1, juridiction UE, RUNBOOK § 4 quater). Tant que le site n'est pas lancé, toutes les
  // mises en ligne (main comme branches) utilisent la base d'aperçu ; la base de production `anne-leads`
  // (59b15fb0-cb56-45a7-a61a-378548fd6fe4) sera branchée au lancement (story 12.4).
  // Le schéma n'évolue que par les fichiers de migrations/ (AD-10).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anne-leads-apercu",
      "database_id": "06a92884-c6f1-4d02-afbe-976d11543385",
      "migrations_dir": "migrations"
    }
  ],
  // Limite de fréquence des formulaires (story 10.3, AD-7) : 5 envois par minute et par adresse IP.
  // namespace_id : un numéro choisi librement, unique dans le compte Cloudflare.
  "ratelimits": [{ "name": "LIMITE_FORMULAIRES", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Tâche planifiée (worker.ts → scheduled) : toutes les 15 minutes, réessaie les e-mails qui ont échoué (story 10.3).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Journaux du Worker visibles dans Cloudflare (Workers → anne-vial-tissot-site → Logs), gratuits.
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "jbcholat-Dev/Anne-Immo---Website",
    // « apercu » : chaque lead est un test, tous les e-mails partent vers la boîte de test (secret BOITE_TEST).
    // Passe à « production » au lancement seulement (story 12.4).
    "ENVIRONNEMENT": "apercu",
    // Boîte d'Anne (décision de JB du 2026-10-07) : reçoit les demandes en production, et reçoit les réponses des prospects
    // (adresse de réponse des confirmations, car anne@annevialtissot.fr n'a pas encore de boîte de réception).
    "BOITE_ANNE": "avialtissot@gmail.com",
    // Adresse du site dans les liens des e-mails (guide, désabonnement, story 10.5). Passe à https://annevialtissot.fr au lancement (story 12.4).
    "URL_SITE": "https://anne-vial-tissot-site.jbcholat.workers.dev"
  }
}
