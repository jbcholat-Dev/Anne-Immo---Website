---
import '../styles/global.css';
import Sprite from '../components/Sprite.astro';
import RetourApercu from '../components/RetourApercu.astro';
import type { Lang } from '../i18n';
interface Props { titre: string; description?: string; lang?: Lang; classe?: string; noindex?: boolean; ogImage?: string }
const { titre, description = '', lang = 'fr', classe = '', noindex = false, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Réglage d'indexation (story 9.2) : tant que PUBLIC_INDEXATION n'est pas « oui », aucune page n'est indexable (aperçu).
const indexable = import.meta.env.PUBLIC_INDEXATION === 'oui';
const robots = noindex || !indexable;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={titre} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <!-- Polices hébergées sur le site (story 8.1, AD-11) ; expérience 8.6 : Newsreader + Instrument Sans en priorité -->
    <link rel="preload" href="/fonts/newsreader-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.setAttribute('data-js', '1'); if (navigator.webdriver) document.documentElement.setAttribute('data-webdriver', '1');</script>
    <slot name="head" />
  </head>
  <body class={classe}>
    <Sprite />
    <slot />
    {!indexable && <RetourApercu />}
  </body>
</html>
