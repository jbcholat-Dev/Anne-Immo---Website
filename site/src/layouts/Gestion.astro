---
// Gabarit de l'espace de gestion des demandes (story 10.7) : sobre, en français seulement (AD-3), jamais indexé.
// Pas de nav du site ni de bouton « Un retour ? » : c'est un outil de travail pour Anne.
import '../styles/global.css';
import { ENTETE_COMPTE } from '../server/acces';
interface Props { titre: string }
const { titre } = Astro.props;
const compte = Astro.request.headers.get(ENTETE_COMPTE) ?? '';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titre} · Gestion des demandes</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="g-tete">
      <a href="/gestion" class="g-marque">Gestion des demandes</a>
      <span class="g-compte">{compte}</span>
    </header>
    <main class="g-page"><slot /></main>
  </body>
</html>
<style is:global>
  .g-tete { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px var(--marge-m, 20px); border-bottom: 1px solid var(--avt-galet); flex-wrap: wrap; }
  .g-marque { font-family: var(--avt-font-display); font-size: 22px; color: var(--avt-brun); }
  .g-compte { font-size: 13px; color: var(--avt-text-muted); }
  .g-page { max-width: 1200px; margin: 0 auto; padding: 32px var(--marge-m, 20px) 80px; display: flex; flex-direction: column; gap: 28px; }
  .g-page h1 { font-size: 34px; }
  .g-page h2 { font-size: 24px; margin-bottom: 12px; }
  .g-recherche { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .g-recherche input { flex: 1 1 260px; min-height: 44px; padding: 8px 14px; border: 1.5px solid var(--avt-brun); border-radius: 8px; background: #fff; font: inherit; }
  .g-table-zone { overflow-x: auto; }
  .g-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .g-table th { text-align: left; font-weight: 500; background: var(--avt-galet); padding: 8px 10px; white-space: nowrap; }
  .g-table td { padding: 8px 10px; border-bottom: 1px solid var(--avt-galet); vertical-align: top; }
  .g-pastille { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--avt-galet); white-space: nowrap; }
  .g-pastille.ok { background: #DDEBDD; }
  .g-pastille.ko { background: #F5D9CF; color: var(--avt-terra-deep); }
  .g-pastille.test { background: var(--avt-brume); color: var(--avt-klein); }
  .g-fiche { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; font-size: 15px; }
  .g-fiche dt { color: var(--avt-text-muted); }
  .g-fiche dd { margin: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
  .g-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .g-actions form { display: inline; }
  .g-bouton { min-height: 40px; padding: 8px 16px; border-radius: 999px; border: 1.5px solid var(--avt-brun); background: transparent; font: inherit; font-size: 14px; color: var(--avt-brun); }
  .g-bouton:hover { background: var(--avt-brun); color: var(--avt-ecru); }
  .g-bouton.danger { border-color: var(--avt-terra-deep); color: var(--avt-terra-deep); }
  .g-bouton.danger:hover { background: var(--avt-terra-deep); color: var(--avt-ecru); }
  .g-message { padding: 12px 16px; border-radius: 8px; background: var(--avt-brume); }
  .g-cadre { border: 1px solid var(--avt-galet); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .g-cadre label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .g-cadre input[type=text] { min-height: 40px; padding: 6px 12px; border: 1.5px solid var(--avt-brun); border-radius: 8px; background: #fff; font: inherit; max-width: 420px; }
  .g-muet { color: var(--avt-text-muted); font-size: 14px; }
</style>
