---
// Lockup co-brandé Anne + eXp (AD-17 : consommé tel quel depuis design-system/assets, jamais recoloré).
// Story 8.25 : les SVG du design system ont 3 unités de marge en haut et en bas (viewBox 0 -3 1206 150), sinon le jambage du « p » d'eXp, qui touche le bas du dessin, était rogné.
// D-21 : version négative sans le cercle écru → le cercle (liseré) est retiré à l'inclusion. Les ids internes sont rendus uniques.
// Les SVG sont inclus à la construction (import ?raw), pas lus sur le disque au rendu : la page de résultats du diagnostic
// est rendue par le serveur (story 10.4), où le dossier design-system n'existe pas.
import svgNegatif from '../../../design-system/assets/lockup-exp-horizontal-negatif.svg?raw';
import svgPositif from '../../../design-system/assets/lockup-exp-horizontal.svg?raw';
interface Props { variante?: 'negatif' | 'positif'; largeur?: number; class?: string }
const { variante = 'negatif', largeur = 488, class: cls = '' } = Astro.props;
let svg = variante === 'negatif' ? svgNegatif : svgPositif;
const uid = `lk${variante}${Math.random().toString(36).slice(2, 7)}`;
svg = svg
  .replace(/<\?xml[^>]*>\s*/g, '')
  .replace('Anne VIAL-TISSOT', 'Anne VIAL\u2011TISSOT')
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace('class="nm"', `style="font-family:'Gilda Display',serif;font-size:calc(46 * var(--px-h));letter-spacing:1.6px;fill:${variante === 'negatif' ? '#F7F2EA' : '#26201A'}"`)
  .replace(/<circle cx="78" cy="80" r="56\.5"[^>]*\/>\s*/, '')
  .replace(/id="sym"/g, `id="${uid}"`)
  .replace(/url\(#sym\)/g, `url(#${uid})`)
  .replace(/<svg xmlns="http:\/\/www.w3.org\/2000\/svg" viewBox="0 -3 1206 150"/, `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -3 1206 150" class="lockup ${cls}" style="width:${largeur}px;height:${Math.ceil((largeur * 150) / 1206)}px"`);
// Si le cadre d'un SVG change encore, la réécriture ci-dessus ne trouverait plus la balise : on arrête la construction plutôt que d'afficher un logo sans taille.
if (!svg.includes('class="lockup')) throw new Error('Lockup : balise <svg> du lockup eXp non reconnue (cadre modifié ?)');
---
<Fragment set:html={svg} />
