---
// § 1.4 Ma méthode, en un coup d'œil (D-15) : trois piliers, puis le refrain révélé ligne par ligne (seul texte animé de la page).
import { t, r, type Lang } from '../../i18n';
import { accent, sansAccent } from '../../lib/texte';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const piliers = lang === 'fr'
  ? [
      { titre: 'Bon sens', texte: 'Comprendre vraiment la situation avant de bouger. Écouter, poser les bonnes questions.' },
      { titre: 'Rigueur', texte: 'La même discipline qu’en finance sur chaque dossier : préparer, anticiper, documenter.' },
      { titre: 'Pragmatisme', texte: 'Faire ce qui fonctionne dans la réalité, et adapter selon le contexte.' },
    ]
  : [
      { titre: 'Common sense', texte: 'Truly understand the situation before moving. Listen, ask the right questions.' },
      { titre: 'Rigour', texte: 'The same discipline as in finance on every file: prepare, anticipate, document.' },
      { titre: 'Pragmatism', texte: 'Do what works in the real world, and adapt to the context.' },
    ];
const refrain = lang === 'fr'
  ? ['Pas de mauvaise surprise.', 'Pas de dossier qui traîne.', 'Des ventes qui vont au bout.']
  : ['No bad surprises.', 'No file left dragging.', 'Sales that go all the way.'];
---
<section class="methode" data-sec="methode" aria-labelledby="methode-titre">
  <div class="methode-tete" data-reveal="titre">
    <div>
      <p class="surtitre"><b>02</b> {d.accueil.sur_methode}</p>
      <h2 id="methode-titre" set:html={accent(d.accueil.methode_titre)} aria-label={sansAccent(d.accueil.methode_titre)} />
    </div>
    <a href={r('methode', lang)} class="lien-fleche seulement-desktop">{d.accueil.methode_lien}</a>
  </div>
  <ol class="piliers" data-reveal="bloc">
    {piliers.map((p, i) => (
      <li class="pilier"><span class="pilier-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{p.titre}</h3><p>{p.texte}</p></li>
    ))}
  </ol>
  <div class="refrain" data-refrain aria-label={lang === 'fr' ? 'Refrain de la marque' : 'Brand refrain'}>
    {refrain.map((l) => <div data-ligne>{l}</div>)}
  </div>
  <a href={r('methode', lang)} class="lien-fleche seulement-mobile methode-lien-m">{d.accueil.methode_lien}</a>
</section>
<style>
  /* Expérience 8.6 : section sable, piliers numérotés, refrain en grand avec la dernière ligne en italique Klein. */
  .methode { position: relative; background: var(--avt-galet); padding: 140px var(--marge) 150px; }
  .methode-tete { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 72px; gap: 24px; }
  .methode-tete h2 { font-size: clamp(44px, 5vw, 72px); }
  .piliers { list-style: none; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 48px; margin-bottom: 140px; }
  .pilier { border-top: 1px solid var(--avt-brun); padding-top: 28px; }
  .pilier-num { display: block; font-family: var(--avt-font-display); font-size: 64px; line-height: 1; color: var(--avt-terra); letter-spacing: -.03em; margin-bottom: 22px; }
  .pilier h3 { font-size: 32px; margin-bottom: 12px; }
  .pilier p { font-size: 17px; line-height: 1.6; color: var(--avt-text-muted); max-width: 34ch; }
  .refrain { font-family: var(--avt-font-display); font-size: clamp(48px, 6.4vw, 96px); line-height: 1.02; letter-spacing: -.03em; }
  .refrain div { color: rgba(22, 24, 29, .16); transition: color .6s ease; }
  .refrain div[data-on] { color: var(--avt-brun); }
  .refrain div:last-child[data-on] { color: var(--avt-klein); font-style: italic; }
  .refrain div:last-child { font-style: italic; }
  html:not([data-js]) .refrain div { color: var(--avt-brun); }
  @media (prefers-reduced-motion: reduce) { .refrain div { color: var(--avt-brun); } .refrain div:last-child { color: var(--avt-klein); } }
  @media (max-width: 899px) {
    .methode { padding: 72px var(--marge-m) 72px; }
    .methode-tete { margin-bottom: 36px; }
    .methode-tete h2 { font-size: 38px; }
    .piliers { grid-template-columns: 1fr; gap: 32px; margin-bottom: 64px; }
    .pilier { padding-top: 18px; }
    .pilier-num { font-size: 44px; margin-bottom: 12px; }
    .pilier h3 { font-size: 27px; }
    .pilier p { font-size: 16px; line-height: 1.55; }
    .refrain { font-size: 36px; }
    .methode-lien-m { margin-top: 36px; }
  }
</style>
