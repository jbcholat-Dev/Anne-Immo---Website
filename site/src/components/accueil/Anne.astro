---
// § 1.7 Anne : portrait (bloc réservé A-04), trois lignes, les quatre langues, « En savoir plus » → /a-propos#qui-suis-je.
import Reserve from '../Reserve.astro';
import { t, r, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="anne" data-sec="anne" aria-labelledby="anne-titre">
  <div class="anne-portrait" data-reveal="bloc">
    <Reserve label={d.accueil.anne_portrait} class="seulement-desktop anne-reserve" />
    <Reserve label={d.accueil.anne_portrait_m} class="seulement-mobile anne-reserve-m" />
  </div>
  <div data-reveal="titre">
    <p class="surtitre"><b>05</b> {d.accueil.sur_anne}</p>
    <h2 id="anne-titre">Anne <em>Vial‑Tissot</em></h2>
    <p class="anne-texte"><span class="seulement-desktop">{d.accueil.anne_texte}</span><span class="seulement-mobile">{d.accueil.anne_texte_m}</span></p>
    <p class="anne-langues"><span class="seulement-desktop">{d.accueil.anne_langues}</span><span class="seulement-mobile">{d.accueil.anne_langues_m}</span></p>
    <a href={r('qui', lang)} class="lien-fleche">{d.accueil.anne_lien}</a>
  </div>
</section>
<style>
  .anne { position: relative; display: grid; grid-template-columns: 5fr 6fr; gap: 96px; padding: 140px var(--marge); align-items: center; background: var(--avt-ecru); }
  .anne-portrait :global(.anne-reserve) { height: 640px; border-radius: var(--avt-radius-card); }
  .anne h2 { font-size: clamp(48px, 5.4vw, 80px); }
  .anne-texte { font-family: var(--avt-font-display); font-size: 26px; line-height: 1.4; letter-spacing: -.005em; max-width: 34ch; margin: 28px 0 24px; }
  .anne-langues { font-size: 13px; letter-spacing: .14em; font-weight: 600; color: var(--avt-text-muted); margin-bottom: 32px; }
  @media (max-width: 899px) {
    .anne { grid-template-columns: 1fr; gap: 28px; padding: 72px var(--marge-m); }
    .anne-portrait :global(.anne-reserve-m) { height: 400px; border-radius: var(--avt-radius-card); }
    .anne h2 { font-size: 44px; }
    .anne-texte { font-size: 20px; margin: 18px 0 16px; }
    .anne-langues { font-size: 12px; margin-bottom: 22px; }
  }
</style>
