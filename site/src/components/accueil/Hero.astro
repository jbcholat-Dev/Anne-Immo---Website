---
// § 1.1 Ouverture (D-1, D-19, D-10) : vidéo drone plein cadre 900 px, voile, bloc nom + positionnement + CTA posé en bas (84 px).
// A-01 réelle (story 8.3, D-27) : le montage d'Anne (52 s depuis le 2026-10-05, story 7.15) tourne en boucle, sans son ; le poster est sa première image, affichée
// pendant le chargement ; le <picture> derrière est le repli (mouvement réduit, échec de chargement, économie de données).
// Les fichiers vidéo sont produits par `npm run video` (scripts/video.mjs) ; s'ils manquent, la balise <video> est masquée.
import fs from 'node:fs';
import Picture from '../Picture.astro';
import { image } from '../../lib/images';
import { hero } from '../../config/site';
import { t, r, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const poster = image(hero.poster)!;
const videoDispo = fs.existsSync(new URL('../../../public/video/ouverture.mp4', import.meta.url));
---
<section class="hero" data-sec="ouverture" aria-labelledby="hero-titre">
  <div class="hero-fond" aria-hidden="true">
    <Picture id={hero.poster} alt="" sizes="100vw" loading="eager" fetchpriority="high" class="hero-poster" />
    <video class:list={['hero-video', !videoDispo && 'hero-video-absente']} poster={poster.jpg} muted autoplay loop playsinline preload="metadata" tabindex="-1" aria-hidden="true">
      {videoDispo && <source src="/video/ouverture.webm" type="video/webm" />}
      {videoDispo && <source src="/video/ouverture.mp4" type="video/mp4" />}
    </video>
    <div class="hero-voile"></div>
  </div>
  <div class="hero-contenu">
    <p class="hero-surtitre" data-reveal="petit">{d.accueil.hero_surtitre}</p>
    <h1 id="hero-titre" data-reveal="titre">Anne <span class="hero-nom">Vial‑Tissot</span></h1>
    <p class="hero-ligne" data-reveal="petit">{d.accueil.hero_ligne}</p>
    <div class="hero-boutons" data-reveal="petit">
      <a href={r('diagnostic', lang)} class="btn btn-primaire"><span class="seulement-desktop">{d.accueil.hero_cta}</span><span class="seulement-mobile">{d.accueil.hero_cta_m}</span></a>
      <a href={`${r('vendre', lang)}#estimation`} class="btn btn-contour-ecru">{d.accueil.hero_cta2}</a>
    </div>
  </div>
</section>

<style>
  /* Expérience 8.6 : la vidéo occupe tout l'écran, le titre devient une vraie signature éditoriale (Newsreader), deux portes d'entrée. */
  .hero { position: relative; height: 100vh; min-height: 680px; max-height: 1000px; overflow: hidden; background: var(--avt-brun); color: var(--avt-ecru); }
  .hero-fond { position: absolute; inset: 0; }
  .hero-fond :global(.hero-poster), .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-video { object-position: center; }
  .hero-video-absente { display: none; } /* fichiers vidéo absents : le poster <picture> suffit */
  .hero-voile { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22, 24, 29, .38) 0%, rgba(22, 24, 29, .08) 30%, rgba(22, 24, 29, .30) 58%, rgba(22, 24, 29, .86) 100%); pointer-events: none; }
  .hero-contenu { position: absolute; left: var(--marge); right: var(--marge); bottom: 80px; }
  .hero-surtitre { font-size: 13px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; color: rgba(251, 249, 245, .85); margin-bottom: 18px; }
  .hero h1 { font-size: clamp(56px, 9.4vw, 148px); font-weight: 350; letter-spacing: -.035em; line-height: .92; color: var(--avt-ecru); white-space: nowrap; }
  .hero-nom { font-style: italic; }
  .hero-ligne { font-size: 20px; line-height: 1.45; margin-top: 26px; color: var(--avt-ecru); max-width: 46ch; }
  .hero-boutons { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  @media (prefers-reduced-motion: reduce) { .hero-video { display: none; } }
  @media (max-width: 899px) {
    .hero { height: 100svh; min-height: 640px; max-height: 820px; }
    .hero-voile { background: linear-gradient(180deg, rgba(22, 24, 29, .45) 0%, rgba(22, 24, 29, .12) 30%, rgba(22, 24, 29, .45) 60%, rgba(22, 24, 29, .9) 100%); }
    .hero-contenu { bottom: 40px; left: var(--marge-m); right: var(--marge-m); }
    .hero-surtitre { font-size: 11.5px; letter-spacing: .12em; margin-bottom: 12px; }
    .hero h1 { font-size: 58px; white-space: normal; line-height: .95; }
    .hero-nom { display: block; }
    .hero-ligne { font-size: 16.5px; margin-top: 16px; }
    .hero-boutons { flex-direction: column; gap: 10px; margin-top: 22px; }
    .hero-boutons .btn { width: 100%; }
  }
</style>

<script>
  // AD-15 (budget de vitesse) : si le visiteur a demandé l'économie de données, on ne charge pas la vidéo, le poster reste.
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  const c = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (v && c?.saveData) { v.querySelectorAll('source').forEach((s) => s.remove()); v.removeAttribute('src'); v.load(); v.classList.add('hero-video-absente'); }
</script>
