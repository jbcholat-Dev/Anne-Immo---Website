---
// § 1.8 Parler à Anne (D-22) : vague puis bande Klein, sans image, deux boutons — la page se ferme, elle ne s'éteint pas.
import { t, r, type Lang } from '../../i18n';
import { accent, sansAccent } from '../../lib/texte';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="parler sur-sombre" data-sec="parler" aria-labelledby="parler-titre">
  <div class="parler-int" data-reveal="titre">
    <h2 id="parler-titre" set:html={accent(d.accueil.parler_titre)} aria-label={sansAccent(d.accueil.parler_titre)} />
    <p>{d.accueil.parler_texte}</p>
    <div class="parler-boutons">
      <a href={`${r('contact', lang)}#reserver`} class="btn btn-primaire">{d.accueil.parler_rdv}</a>
      <a href={`${r('contact', lang)}#ecrire`} class="btn btn-contour-ecru">{d.accueil.parler_ecrire}</a>
    </div>
  </div>
</section>
<style>
  /* Expérience 8.6 : la page se ferme sur l'encre, qui se prolonge dans le pied de page — un seul grand bloc sombre. */
  .parler { position: relative; background: var(--avt-brun); color: var(--avt-ecru); padding: 160px var(--marge) 140px; }
  .parler-int { max-width: 1100px; }
  .parler h2 { font-size: clamp(64px, 10vw, 160px); line-height: .9; letter-spacing: -.04em; color: var(--avt-ecru); margin-bottom: 32px; }
  .parler h2 :global(em) { color: var(--avt-terra); }
  .parler p { font-size: 20px; margin-bottom: 40px; color: var(--avt-text-on-dark-muted); }
  .parler-boutons { display: flex; gap: 14px; flex-wrap: wrap; }
  @media (max-width: 899px) {
    .parler { padding: 88px var(--marge-m) 72px; }
    .parler h2 { font-size: 64px; margin-bottom: 18px; }
    .parler p { font-size: 17px; margin-bottom: 28px; }
    .parler-boutons { flex-direction: column; gap: 12px; }
    .parler-boutons .btn { width: 100%; }
  }
</style>
