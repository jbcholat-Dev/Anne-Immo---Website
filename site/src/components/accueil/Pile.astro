---
// § 1.3 Ventes récentes (D-16) : six cartes collantes — top = nav + 24 px, sans scale ni flou, gardée en mobile, en flux sous mouvement réduit.
// Stories réelles d'abord, complétées par des ventes réelles « à venir » (même gabarit, photo = bloc réservé A-02) jusqu'à six cartes.
// Une vente « à venir » dont la story existe n'est pas reprise (sinon la commune apparaît deux fois). Citation courte quand un avis est relié.
import Picture from '../Picture.astro';
import { r, type Lang } from '../../i18n';
import { dicoAccueil } from '../../lib/textes';
import { stories, photoPrincipale, avisDeStory, avisParId, roleLibelle } from '../../lib/contenu';
import { accueil, phrasesStories } from '../../config/site';
import { tiret } from '../../lib/texte';
import Rubrique from './Rubrique.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = await dicoAccueil(lang);
const toutes = await stories();
type Carte = { titre: string; phrase: string; citation?: { texte: string; auteur: string; role: string }; photo: string | null; alt: string; lien: string | null; sousTitre?: string };
const cartes: Carte[] = [];
for (const s of toutes) {
  const avis = await avisDeStory(s.id);
  const a = avis[0];
  cartes.push({
    titre: s.data.commune,
    phrase: phrasesStories[s.id] ?? s.data.particularite ?? '',
    citation: a ? { texte: premierePhrase(a.body ?? ''), auteur: a.data.auteur, role: roleLibelle(a, lang) } : undefined,
    photo: photoPrincipale(s),
    alt: `${s.data.type_bien} vendu à ${s.data.commune}`,
    lien: `${r('realisation', lang)}/${s.id}`,
  });
}
const MAX_CARTES = 6; // D-16
cartes.splice(MAX_CARTES);
const dejaRacontees = new Set(toutes.map((s) => s.id));
for (const v of accueil.aVenir.filter((v) => !dejaRacontees.has(v.slug)).slice(0, MAX_CARTES - cartes.length)) {
  const a = v.avis ? await avisParId(v.avis) : null;
  cartes.push({
    titre: v.commune,
    phrase: `${v.type} · ${d.accueil.vendu.toLowerCase()} ${v.annee}`,
    sousTitre: d.accueil.story_a_venir,
    citation: a && a.data.confiance === 'forte' ? { texte: premierePhrase(a.body ?? ''), auteur: a.data.auteur, role: roleLibelle(a, lang) } : undefined,
    photo: null,
    alt: '',
    lien: null,
  });
}
const [une, ...suite] = cartes;
function premierePhrase(texte: string) {
  const t = texte.trim().replace(/\s+/g, ' ');
  const m = t.match(/^[^.!?]{20,220}[.!?]/);
  return (m ? m[0] : t.slice(0, 200)).trim();
}
---
<section class="ventes" data-sec="ventes" aria-labelledby="ventes-titre">
  <Rubrique num="01" nom={lang === 'fr' ? 'Les ventes' : 'Sales'} />
  <div class="ventes-tete" data-reveal="titre">
    <h2 id="ventes-titre">{d.accueil.ventes_titre}</h2>
  </div>
  {une && (
    <article class="une" data-reveal="bloc">
      <div class="une-photo tirage">
        {une.photo && <Picture id={une.photo} alt={une.alt} sizes="(max-width: 899px) 100vw, 58vw" />}
      </div>
      <div class="une-texte">
        <div class="une-etiquette">{lang === 'fr' ? 'À la une' : 'Featured'}</div>
        <h3>{tiret(une.titre)}</h3>
        {une.phrase && <p class="une-phrase">« {une.phrase} »</p>}
        {une.citation && <p class="une-citation">« {une.citation.texte} » <span>{une.citation.auteur} · {une.citation.role}</span></p>}
        {une.lien && <a href={une.lien} class="lien-fleche">{d.accueil.voir_vente} <span aria-hidden="true">→</span></a>}
      </div>
    </article>
  )}
  <ol class="sommaire" data-reveal="bloc">
    {suite.map((c, i) => (
      <li class="sommaire-ligne">
        <span class="sommaire-num">{String(i + 2).padStart(2, '0')}</span>
        <div class="sommaire-texte">
          <h3>{c.lien ? <a href={c.lien}>{tiret(c.titre)}</a> : tiret(c.titre)}</h3>
          {c.phrase && <p>{c.lien ? `« ${c.phrase} »` : c.phrase}</p>}
          {c.sousTitre && <span class="sommaire-etiquette">{c.sousTitre}</span>}
        </div>
        <div class="sommaire-photo">
          {c.photo ? <Picture id={c.photo} alt={c.alt} sizes="220px" /> : <span class="sommaire-vide" aria-hidden="true"></span>}
        </div>
      </li>
    ))}
  </ol>
  <a href={r('realisation', lang)} class="lien-fleche ventes-tout">{d.accueil.ventes_lien} <span aria-hidden="true">→</span></a>
</section>

<style>
  /* Concept « Magazine et matière » : la pile collante laisse place à une vente « à la une » (grande photo tirée sur papier),
     puis un sommaire numéroté des autres ventes, comme la table des matières d'un magazine. */
  .ventes { position: relative; padding: 120px var(--marge) 110px; }
  .ventes-tete { margin-bottom: 64px; }
  .ventes-tete h2 { font-size: 64px; line-height: 1.04; max-width: 17ch; letter-spacing: -.005em; }
  .une { display: grid; grid-template-columns: 1.45fr 1fr; gap: 64px; align-items: end; margin-bottom: 88px; }
  .une-photo { height: 620px; }
  .une-photo :global(picture), .une-photo :global(img) { width: 100%; height: 100%; }
  .une-photo :global(img) { object-fit: cover; }
  .une-texte { display: flex; flex-direction: column; gap: 18px; padding-bottom: 8px; }
  .une-etiquette { font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; font-weight: 500; color: var(--avt-terra-deep); }
  .une h3 { font-size: 60px; line-height: 1; }
  .une-phrase { font-family: var(--avt-font-display); font-size: 25px; line-height: 1.35; }
  .une-citation { font-size: 15px; line-height: 1.55; border-left: 2px solid var(--avt-terra); padding-left: 14px; }
  .une-citation span { color: var(--avt-text-muted); }
  .sommaire { list-style: none; border-top: 1px solid var(--avt-brun); }
  .sommaire-ligne { display: grid; grid-template-columns: 90px 1fr 220px; gap: 32px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--filet-brun-fort); }
  .sommaire-num { font-family: var(--avt-font-display); font-size: 44px; color: var(--avt-terra-deep); line-height: 1; font-variant-numeric: tabular-nums; }
  .sommaire-texte h3 { font-size: 38px; line-height: 1.1; }
  .sommaire-texte h3 a { color: var(--avt-brun); }
  .sommaire-texte h3 a:hover { color: var(--avt-klein); text-decoration: none; }
  .sommaire-texte p { font-size: 16px; line-height: 1.55; margin-top: 8px; max-width: 62ch; color: var(--avt-text-muted); }
  .sommaire-etiquette { display: inline-block; margin-top: 10px; font-size: 11.5px; letter-spacing: .16em; text-transform: uppercase; font-weight: 500; color: var(--avt-text-muted); }
  .sommaire-photo { height: 140px; border-radius: 4px; overflow: hidden; }
  .sommaire-photo :global(picture), .sommaire-photo :global(img) { width: 100%; height: 100%; }
  .sommaire-photo :global(img) { object-fit: cover; transition: transform .6s var(--ease-bloc); }
  .sommaire-ligne:hover .sommaire-photo :global(img) { transform: scale(1.04); }
  .sommaire-vide { display: block; width: 100%; height: 100%; background: repeating-linear-gradient(-45deg, transparent 0 9px, var(--filet-brun-fort) 9px 10px); }
  .ventes-tout { display: inline-flex; margin-top: 40px; }
  @media (max-width: 899px) {
    .ventes { padding: 64px var(--marge-m) 64px; }
    .ventes-tete { margin-bottom: 32px; }
    .ventes-tete h2 { font-size: 36px; line-height: 1.1; }
    .une { grid-template-columns: 1fr; gap: 24px; margin-bottom: 48px; }
    .une-photo { height: 300px; }
    .une h3 { font-size: 40px; }
    .une-phrase { font-size: 21px; }
    .sommaire-ligne { grid-template-columns: 48px 1fr; gap: 14px; padding: 22px 0; }
    .sommaire-num { font-size: 30px; align-self: start; }
    .sommaire-texte h3 { font-size: 28px; }
    .sommaire-texte p { font-size: 15px; }
    .sommaire-photo { grid-column: 2; height: 170px; }
    .sommaire-photo:has(.sommaire-vide) { display: none; }
  }
</style>
