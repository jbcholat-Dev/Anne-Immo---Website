---
// § 1.2 La preuve, tout de suite (D-20) : bande Klein compacte — note, nombre d'avis (instantané), un extrait attribué, lien vers la fiche.
import { t, type Lang } from '../../i18n';
import { instantane, avisParId, roleLibelle } from '../../lib/contenu';
import { accueil } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const inst = await instantane();
const a = await avisParId(accueil.extrait.avis);
const note = String(inst.note).replace('.', ',');
---
<section class="preuve" data-sec="preuve" aria-label="Avis Immodvisor">
  <div class="preuve-note" data-reveal="petit"><b>{note}<small>/5</small></b><span>{inst.nombre_avis} {d.accueil.preuve_avis}</span></div>
  <figure class="preuve-citation" data-reveal="titre">
    <blockquote>«&nbsp;{accueil.extrait.phrase}&nbsp;»</blockquote>
    <figcaption>{a.data.auteur}, {roleLibelle(a, lang)} · <a href={inst.url_fiche} rel="noopener" target="_blank">{d.accueil.preuve_lien}</a></figcaption>
  </figure>
</section>
<style>
  /* Expérience 8.6 : la preuve devient une grande citation éditoriale, la note en chiffres Klein. */
  .preuve { display: grid; grid-template-columns: 300px 1fr; gap: 64px; align-items: center; padding: 120px var(--marge); background: var(--avt-ecru); border-bottom: 1px solid var(--filet-brun-fort); }
  .preuve-note { display: flex; flex-direction: column; gap: 10px; }
  .preuve-note b { font-family: var(--avt-font-display); font-weight: 350; font-size: 128px; line-height: .85; letter-spacing: -.04em; color: var(--avt-klein); font-variant-numeric: lining-nums; }
  .preuve-note small { font-size: 40px; letter-spacing: -.01em; color: var(--avt-text-muted); margin-left: 4px; }
  .preuve-note span { font-size: 15px; color: var(--avt-text-muted); }
  .preuve-citation blockquote { font-family: var(--avt-font-display); font-style: italic; font-size: 40px; line-height: 1.2; letter-spacing: -.012em; max-width: 30ch; }
  .preuve-citation figcaption { margin-top: 22px; font-size: 15px; color: var(--avt-text-muted); }
  @media (max-width: 899px) {
    .preuve { grid-template-columns: 1fr; gap: 28px; padding: 64px var(--marge-m); }
    .preuve-note b { font-size: 88px; }
    .preuve-note small { font-size: 28px; }
    .preuve-citation blockquote { font-size: 27px; line-height: 1.25; }
  }
</style>
