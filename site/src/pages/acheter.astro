---
// 09 Acheter (D-5) : primo-accédants et investisseurs, la recherche accompagnée en quatre temps, les avis d'acheteurs (§ 5.4), « Parler de votre projet » → contact préréglé Achat.
import Page from '../layouts/Page.astro';
import { avisParId, storyDeAvis, storyVisible, roleLibelle, dateLibelle, paragraphes, instantane } from '../lib/contenu';
import { acheter } from '../config/site';
import { r } from '../i18n';
import { textes, court } from '../lib/textes';
const inst = await instantane();
const avis = await Promise.all(acheter.avis.map(async (id) => { const a = await avisParId(id); const slug = storyDeAvis(a); const story = await storyVisible(slug); return { a, slug, story }; }));
// Textes modifiables par Anne : contenu-anne/textes/acheter.yml (story 7.20).
const x = await textes('acheter');
---
<Page titre={`${x.titre} — Anne VIAL-TISSOT`} description={x.description} courante="acheter">
  <div class="ac-tete">
    <div class="ac-tete-rang"><h1>{x.titre}</h1><span class="marqueur">Contenu à écrire par Anne</span></div>
    <p class="seulement-desktop">{x.intro}</p>
    <p class="seulement-mobile">{court(x.intro_court, x.intro)}</p>
    <a href={`${r('contact')}?projet=achat#ecrire`} class="btn btn-primaire seulement-mobile ac-cta-haut">{x.bouton}</a>
  </div>
  <div class="ac-profils">
    {[x.primo, x.investisseurs].map((p) => (
      <section><h2 class="chapeau">{p.chapeau}</h2><h3>{p.titre}</h3><p class="seulement-desktop">{p.texte}</p><p class="seulement-mobile">{court(p.texte_court, p.texte)}</p></section>
    ))}
  </div>
  <section class="ac-recherche" aria-labelledby="recherche-titre">
    <h2 id="recherche-titre">{x.recherche.titre}</h2>
    <p class="ac-recherche-intro"><span class="seulement-desktop">{x.recherche.intro}</span><span class="seulement-mobile">{court(x.recherche.intro_court, x.recherche.intro)}</span></p>
    <div class="ac-temps">
      {x.recherche.temps.map((m, i) => (
        <div class="ac-temp"><div class="ac-num">{i + 1}</div><div><h3>{m.titre}</h3><p class="seulement-desktop">{m.texte}</p><p class="seulement-mobile">{court(m.texte_court, m.texte)}</p></div></div>
      ))}
    </div>
  </section>
  <section class="ac-avis" aria-labelledby="ac-avis-titre">
    <h2 id="ac-avis-titre">{x.avis.titre}</h2>
    <p class="ac-avis-intro"><span class="seulement-desktop">{x.avis.intro}</span><span class="seulement-mobile">{court(x.avis.intro_court, x.avis.intro)}</span></p>
    <div class="ac-avis-grille">
      {avis.map((x) => (
        <figure>
          <blockquote>{paragraphes(x.a.body).map((p) => <p>{p}</p>)}</blockquote>
          <figcaption>{x.a.data.auteur} <span class="texte-muet">· {[roleLibelle(x.a), x.story?.data.commune, dateLibelle(x.a.data.date)].filter(Boolean).join(' · ')}</span>
            {x.slug && x.story && <div class="ac-avis-lien"><a href={`${r('realisation')}/${x.slug}`}>Voir cette vente</a></div>}
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="ac-avis-tous"><a href={inst.url_fiche} rel="noopener" target="_blank">Voir les {inst.nombre_avis} avis sur Immodvisor</a></div>
  </section>
  <div class="ac-cta"><a href={`${r('contact')}?projet=achat#ecrire`} class="btn btn-primaire">{x.bouton}</a></div>
</Page>
<style>
  .ac-tete { padding: 88px var(--marge) 40px; }
  .ac-tete-rang { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .ac-tete h1 { font-size: 84px; line-height: 1; }
  .ac-tete p { font-size: 19px; line-height: 1.6; max-width: 56ch; }
  .ac-profils { padding: 0 var(--marge) 96px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .ac-profils section { border-top: 1px solid var(--avt-brun); padding-top: 24px; }
  .ac-profils h2 { font-family: var(--avt-font-text); margin-bottom: 12px; }
  .ac-profils h3 { font-size: 36px; margin-bottom: 14px; }
  .ac-profils p { font-size: 17px; line-height: 1.7; max-width: 52ch; }
  .ac-recherche { background: var(--avt-brume); padding: 96px var(--marge); }
  .ac-recherche h2 { font-size: 52px; margin-bottom: 16px; }
  .ac-recherche-intro { font-size: 17px; line-height: 1.6; margin-bottom: 56px; max-width: 58ch; }
  .ac-temps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .ac-temp { display: flex; flex-direction: column; gap: 12px; }
  .ac-num { font-family: var(--avt-font-display); font-size: 44px; line-height: 1; color: var(--avt-terra); }
  .ac-temp h3 { font-size: 28px; margin-bottom: 12px; }
  .ac-temp p { font-size: 16px; line-height: 1.6; }
  .ac-avis { padding: 96px var(--marge) 0; }
  .ac-avis h2 { font-size: 40px; margin-bottom: 10px; }
  .ac-avis-intro { font-size: 15px; color: var(--avt-text-muted); margin-bottom: 40px; max-width: 64ch; }
  .ac-avis-grille { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  figure { display: flex; flex-direction: column; gap: 16px; border-top: 1px solid var(--avt-brun); padding-top: 20px; }
  blockquote { display: flex; flex-direction: column; gap: 10px; font-size: 17px; line-height: 1.6; }
  blockquote p:first-child::before { content: '« '; }
  blockquote p:last-child::after { content: ' »'; }
  figcaption { font-size: 14px; }
  .ac-avis-lien { margin-top: 10px; font-size: 14.5px; }
  .ac-avis-tous { margin-top: 32px; font-size: 13.5px; }
  .ac-cta { padding: 56px var(--marge) 96px; }
  @media (max-width: 899px) {
    .ac-tete { padding: 40px var(--marge-m) 24px; }
    .ac-tete-rang { margin-bottom: 14px; }
    .ac-tete h1 { font-size: 52px; }
    .ac-tete p { font-size: 16px; margin-bottom: 18px; }
    .ac-profils { padding: 0 var(--marge-m) 40px; grid-template-columns: 1fr; gap: 28px; }
    .ac-profils section { padding-top: 18px; }
    .ac-profils h2 { font-size: 12px; margin-bottom: 8px; }
    .ac-profils h3 { font-size: 30px; margin-bottom: 10px; }
    .ac-profils p { font-size: 16px; line-height: 1.6; }
    .ac-recherche { padding: 48px var(--marge-m); }
    .ac-recherche h2 { font-size: 34px; margin-bottom: 10px; }
    .ac-recherche-intro { font-size: 15.5px; margin-bottom: 32px; }
    .ac-temps { grid-template-columns: 1fr; gap: 26px; }
    .ac-temp { flex-direction: row; gap: 16px; }
    .ac-num { font-size: 34px; flex: none; width: 32px; }
    .ac-temp h3 { font-size: 24px; margin-bottom: 6px; }
    .ac-temp p { font-size: 15.5px; line-height: 1.55; }
    .ac-avis { padding: 48px var(--marge-m) 0; }
    .ac-avis h2 { font-size: 30px; margin-bottom: 8px; }
    .ac-avis-intro { font-size: 14px; margin-bottom: 24px; }
    .ac-avis-grille { grid-template-columns: 1fr; gap: 22px; }
    figure { padding-top: 16px; }
    blockquote { font-size: 16px; line-height: 1.55; }
    .ac-cta { padding: 36px var(--marge-m) 48px; }
    .ac-cta .btn { display: flex; width: 100%; }
  }
</style>
