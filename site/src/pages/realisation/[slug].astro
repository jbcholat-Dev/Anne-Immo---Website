---
// 06 Story — fiche d'une vente : photo maîtresse, contexte, récit d'Anne, témoignages (vendeur / acheteur, rôle affiché), galerie, CTA.
import Page from '../../layouts/Page.astro';
import Picture from '../../components/Picture.astro';
import { image } from '../../lib/images';
import Reserve from '../../components/Reserve.astro';
import CtaFin from '../../components/CtaFin.astro';
import { render } from 'astro:content';
import { stories, photosDeStory, avisDeStory, roleLibelle, paragraphes, phraseDeAvis } from '../../lib/contenu';
import AvisCarte from '../../components/AvisCarte.astro';
import { tiret } from '../../lib/texte';
import { r } from '../../i18n';
export async function getStaticPaths() {
  return (await stories()).map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}
const { story } = Astro.props;
const { Content } = await render(story);
const photos = photosDeStory(story);
const principale = photos.find((p) => p.role === 'principale');
const secondaires = photos.filter((p) => p.role === 'secondaire');
// Visionneuse (retour de JB n° 64, story 8.9) : un clic sur une photo l'agrandit ; flèches, boutons ou glissé pour passer à la suivante.
const vues = [principale, ...secondaires].filter((p) => p && image(p.cle)).map((p) => {
  const img = image(p!.cle)!;
  return { src: img.webp.at(-1)?.src ?? img.jpg, l: img.largeur, h: img.hauteur };
});
const decalage = principale && image(principale.cle) ? 1 : 0;
// Témoignages : ceux du front matter (A-07) d'abord ; sinon les avis Immodvisor reliés (v1) ; sinon bloc réservé.
const propres = story.data.temoignages.filter((t) => t.citation);
const avis = propres.length ? [] : await avisDeStory(story.id);
const temoignages = propres.length
  ? propres.map((t) => ({ role: t.role === 'vendeur' ? 'vendeur' : 'acheteur', prenom: t.prenom ?? '', texte: [t.citation!], source: null as string | null, phrase: null as string | null }))
  : avis.map((a) => ({ role: roleLibelle(a), prenom: a.data.auteur, texte: paragraphes(a.body), source: 'Avis Immodvisor', phrase: phraseDeAvis(a) }));
const titreTemoignages = temoignages.length === 1 ? (temoignages[0].role.startsWith('vendeu') ? (temoignages[0].role === 'vendeuse' ? 'Ce qu’elle en dit' : 'Ce qu’il en dit') : 'Ce qu’il en dit') : 'Ce qu’ils en disent';
const alt = `${story.data.type_bien} vendu à ${story.data.commune}`;
---
<Page titre={`${story.data.commune} — Réalisations — Anne VIAL-TISSOT`} description={(story.data.particularite ?? '').trim()} courante="realisation">
  <div class="story-photo">
    {principale ? <button type="button" class="zoom" data-zoom="0" aria-label="Agrandir la photo"><Picture id={principale.cle} alt={alt} sizes="100vw" loading="eager" fetchpriority="high" /></button> : <Reserve label={`A-02 · photo maîtresse · ${story.data.commune} · 16:9 plein cadre`} style="height:100%" />}
  </div>
  <div class="story-corps">
    <aside class="story-contexte">
      <a href={r('realisation')} class="story-retour">← Toutes les ventes</a>
      <div><div class="chapeau-muet">Commune</div>{story.data.commune}</div>
      <div><div class="chapeau-muet">Type de bien</div>{story.data.type_bien}</div>
      {story.data.delai_vente && <div><div class="chapeau-muet">Délai de vente</div>{story.data.delai_vente}</div>}
      {story.data.annee_vente && <div><div class="chapeau-muet">Vendu</div>{story.data.annee_vente}</div>}
    </aside>
    <div class="story-texte">
      <a href={r('realisation')} class="story-retour seulement-mobile">← Toutes les ventes</a>
      <h1>{tiret(story.data.commune)}</h1>
      <div class="story-meta seulement-mobile">
        <span class="texte-muet">{story.data.type_bien}</span>
        {story.data.annee_vente && <span>Vendu {story.data.annee_vente}</span>}
        {story.data.delai_vente && <span>{story.data.delai_vente}</span>}
      </div>
      <h2 class="chapeau">Le récit d'Anne</h2>
      <div class="recit"><Content /></div>
      <h2 class="chapeau">{titreTemoignages}</h2>
      <div class="temoignages">
        {temoignages.length === 0 && <Reserve label="Actif attendu A-07 · témoignage, cité et attribué (vendeur ou acheteur)" style="height:160px" />}
        {temoignages.map((t) => (
          <AvisCarte taille="grande" phrase={t.phrase} texte={t.texte} lignes={8}>{t.prenom}{' '}<span class="texte-muet">· {t.role}{t.source && ` · ${t.source}`}</span></AvisCarte>
        ))}
      </div>
    </div>
  </div>
  {secondaires.length > 0 && (
    <div class="story-galerie" aria-label="Galerie">
      {secondaires.map((p, i) => <button type="button" class="story-galerie-photo zoom" data-zoom={i + decalage} aria-label={`Agrandir la photo ${i + decalage + 1} sur ${vues.length}`}><Picture id={p.cle} alt={alt} sizes="(max-width: 899px) 240px, 25vw" /></button>)}
    </div>
  )}
  {vues.length > 0 && (
    <dialog class="visionneuse" data-visionneuse data-vues={JSON.stringify(vues)} aria-label={`Photos · ${story.data.commune}`}>
      <img alt={alt} data-vue />
      <button type="button" class="visionneuse-btn visionneuse-fermer" data-fermer aria-label="Fermer">✕</button>
      {vues.length > 1 && <>
        <button type="button" class="visionneuse-btn visionneuse-prec" data-prec aria-label="Photo précédente">‹</button>
        <button type="button" class="visionneuse-btn visionneuse-suiv" data-suiv aria-label="Photo suivante">›</button>
        <p class="visionneuse-compte" data-compte aria-live="polite"></p>
      </>}
    </dialog>
  )}
  <CtaFin titre="Et votre vente ?" texte="Trois minutes pour savoir où elle en est, ou un créneau pour en parler." />
</Page>
<script>
  const d = document.querySelector<HTMLDialogElement>('[data-visionneuse]');
  if (d) {
    const vues: { src: string; l: number; h: number }[] = JSON.parse(d.dataset.vues ?? '[]');
    const img = d.querySelector<HTMLImageElement>('[data-vue]')!;
    const compte = d.querySelector<HTMLElement>('[data-compte]');
    let i = 0;
    const montrer = (n: number) => {
      i = (n + vues.length) % vues.length;
      img.src = vues[i].src; img.width = vues[i].l; img.height = vues[i].h;
      if (compte) compte.textContent = `${i + 1} / ${vues.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => { montrer(Number(b.dataset.zoom)); d.showModal(); }));
    d.querySelector('[data-prec]')?.addEventListener('click', () => montrer(i - 1));
    d.querySelector('[data-suiv]')?.addEventListener('click', () => montrer(i + 1));
    d.querySelector('[data-fermer]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); }); // clic hors de la photo
    d.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); montrer(i - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); montrer(i + 1); }
    });
    let x0 = 0; // glissé du doigt sur téléphone
    d.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    d.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) montrer(i + (dx < 0 ? 1 : -1)); });
  }
</script>

<style>
  .zoom { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .visionneuse { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(28, 24, 20, .94); }
  .visionneuse[open] { display: flex; align-items: center; justify-content: center; }
  .visionneuse::backdrop { background: rgba(28, 24, 20, .94); }
  .visionneuse img { max-width: calc(100vw - 160px); max-height: calc(100dvh - 120px); width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  .visionneuse-btn { position: absolute; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid rgba(247, 242, 234, .5); background: rgba(38, 32, 26, .5); color: var(--avt-ecru); font-size: 28px; line-height: 1; cursor: pointer; }
  .visionneuse-btn:hover { background: rgba(247, 242, 234, .16); }
  .visionneuse-fermer { top: 24px; right: 24px; font-size: 20px; }
  .visionneuse-prec { left: 24px; top: 50%; transform: translateY(-50%); }
  .visionneuse-suiv { right: 24px; top: 50%; transform: translateY(-50%); }
  .visionneuse-compte { position: absolute; bottom: 24px; left: 0; right: 0; text-align: center; color: var(--avt-ecru); font-size: 14px; letter-spacing: .08em; }
  @media (max-width: 899px) {
    .visionneuse img { max-width: 100vw; max-height: calc(100dvh - 140px); border-radius: 0; }
    .visionneuse-btn { width: 48px; height: 48px; }
    .visionneuse-prec, .visionneuse-suiv { top: auto; bottom: 16px; transform: none; }
    .visionneuse-fermer { top: 16px; right: 16px; }
    .visionneuse-compte { bottom: 30px; }
  }
  .story-photo { height: 640px; background: var(--avt-galet); overflow: hidden; }
  .story-photo :global(picture), .story-photo :global(img) { width: 100%; height: 100%; }
  .story-photo :global(img) { object-fit: cover; }
  .story-corps { padding: 72px var(--marge) 0; display: grid; grid-template-columns: 360px 1fr; gap: 80px; }
  .story-contexte { display: flex; flex-direction: column; gap: 22px; font-size: 15px; }
  .story-contexte .chapeau-muet { margin-bottom: 6px; }
  .story-retour { font-size: 14px; }
  .story-texte { max-width: 64ch; }
  .story-texte h1 { font-size: 64px; line-height: 1.05; margin-bottom: 36px; }
  .story-texte h2.chapeau { font-family: var(--avt-font-text); margin: 0 0 14px; }
  .recit { font-size: 17px; line-height: 1.7; margin-bottom: 48px; }
  .recit :global(h1) { font-size: 30px; line-height: 1.2; margin: 0 0 24px; }
  .recit :global(h2) { font-size: 26px; margin: 32px 0 12px; }
  .recit :global(h3) { font-size: 22px; margin: 24px 0 8px; }
  .recit :global(p) { margin: 0 0 16px; }
  .recit :global(ul), .recit :global(ol) { padding-left: 20px; margin: 0 0 16px; display: flex; flex-direction: column; gap: 6px; }
  .recit :global(strong) { font-weight: 500; }
  .recit :global(em) { font-style: italic; }
  .temoignages { display: flex; flex-direction: column; gap: 24px; margin-bottom: 56px; }
  .story-galerie { padding: 0 var(--marge) 80px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .story-galerie-photo { height: 220px; border-radius: 12px; overflow: hidden; background: var(--avt-galet); }
  .story-galerie-photo :global(picture), .story-galerie-photo :global(img) { width: 100%; height: 100%; }
  .story-galerie-photo :global(img) { object-fit: cover; }
  /* Largeurs intermédiaires (900 à 1199 px, sans artboard) : colonnes proportionnelles, sinon le texte déborde (story 8.2) */
  @media (min-width: 900px) and (max-width: 1199px) {
    .story-corps { grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 48px; }
    .story-texte h1 { font-size: 48px; }
  }
  @media (max-width: 899px) {
    .story-photo { height: 300px; }
    .story-corps { padding: 28px var(--marge-m) 0; display: block; }
    .story-contexte { display: none; }
    .story-texte h1 { font-size: 40px; margin: 16px 0 14px; }
    .story-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; margin-bottom: 28px; }
    .story-texte h2.chapeau { font-size: 12px; margin-bottom: 12px; }
    .recit { font-size: 16px; line-height: 1.65; margin-bottom: 36px; }
    .recit :global(h1) { font-size: 26px; }
    .temoignages { gap: 20px; margin-bottom: 36px; }
    .story-galerie { display: flex; gap: 10px; padding: 0 var(--marge-m) 36px; overflow-x: auto; }
    .story-galerie-photo { height: 180px; min-width: 240px; flex: none; }
  }
</style>
