---
// 04 Résultats (§ 8.2, D-23) : score global, profil (Klein / terra-deep / brun), 3 sous-scores brut + %, 9 feedbacks, sortie A ou B, guide.
// Rendue par le serveur depuis la story 10.4 (AD-5) : seulement pour le navigateur qui a ouvert le lien du gate, pendant 24 heures ;
// sinon « Ce lien n'est plus valable », en 404. Voir src/server/resultats.ts.
import Quiz from '../../layouts/Quiz.astro';
import feedbacks from '../../content/diagnostic/feedbacks.json';
import contenu from '../../content/diagnostic/questions.json';
import bareme from '../../content/diagnostic/bareme.json';
import { ouvrir } from '../../server/resultats';
import { envSite } from '../../server/env';
import { lienDesabonnement } from '../../server/liens';
import { NOMBRE_ETAPES, PREMIER_DELAI } from '../../server/sequence';

export const prerender = false;

const ouverture = await ouvrir(Astro.url, Astro.cookies);
if (ouverture.etat === 'redirection') return Astro.redirect('/diagnostic/resultats', 303);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (ouverture.etat === 'introuvable') Astro.response.status = 404;
const r = ouverture.etat === 'resultats' ? ouverture.resultats : null;

type Fb = { insight: string; impact: string };
const cats = contenu.categories as Record<string, { resultat?: string }>;
const profil = r ? (bareme.profils.find((p) => p.id === r.scores.profil) ?? bareme.profils[0]) : null;
const axes = r
  ? (['preparation', 'visibilite', 'efficacite'] as const).map((k) => ({
      k, nom: cats[k].resultat!, ...r.scores.categories[k],
      fb: (feedbacks as unknown as Record<string, Record<string, Fb>>)[k][r.scores.categories[k].bande],
    }))
  : [];
const s = (r ? feedbacks.sorties[r.orientation] : feedbacks.sorties.B) as { titre: string; texte: string; texte_court?: string; cta: string; cta2?: string; sequence?: string; sequence_cta?: string };
const A = r?.orientation === 'A';
// Séquence (story 10.5) : le nombre réel d'e-mails et le délai du premier, et le lien de désabonnement signé de ce lead.
const n = (t?: string) => (t ?? '').replace('{n}', String(NOMBRE_ETAPES));
const premier = PREMIER_DELAI <= 1 ? 'demain' : `dans ${PREMIER_DELAI} jours`;
const desabonnement = r ? ((await lienDesabonnement(envSite, r.id)) ?? '/confidentialite') : '/confidentialite';
---
<Quiz titre="Vos résultats — Diagnostic — Anne VIAL-TISSOT" mode="resultats">
  <div class="rs" data-resultats data-ton={profil?.ton}>
    {!r && (
      <div class="rs-expire" data-expire>
        <h1>Ce lien n'est plus valable</h1>
        <p>Vos résultats s'affichent pendant 24 heures, dans le navigateur où vous avez fait le diagnostic. Leur résumé vous a été envoyé par e-mail. Pour un diagnostic à jour, refaites-le : il prend cinq minutes.</p>
        <a href="/diagnostic/questions" class="btn btn-primaire">Refaire le diagnostic</a>
        <a href="/contact" class="rs-refaire">Écrire à Anne</a>
      </div>
    )}
    {r && profil && (
      <div data-contenu>
        <div class="rs-tete">
          <div><div class="chapeau-muet" style="margin-bottom:10px">Votre score global</div><div class="rs-score"><b>{r.scores.total}</b><span>/ 100</span></div>
            <div class="seulement-mobile"><span class="rs-pastille">{profil.libelle}</span><p class="rs-profil-texte">{profil.texte}</p></div></div>
          <div class="seulement-desktop"><span class="rs-pastille">{profil.libelle}</span><p class="rs-profil-texte">{profil.texte}</p></div>
        </div>
        <div class="rs-resume">{axes.map((a) => <div><div class="rs-resume-rang"><span>{a.nom}</span><b>{a.brut} <small>/ {a.max} · {a.pourcent} %</small></b></div><div class="rs-barre"><div style={`width:${a.pourcent}%`}></div></div></div>)}</div>
        <div class="rs-axes">{axes.map((a) => (
          <section class="rs-axe"><div><div class="chapeau">{a.nom}<span class="seulement-mobile"> · {a.brut} / {a.max}</span></div><div class="rs-sous"><b>{a.brut}</b><span>/ {a.max} · {a.pourcent} %</span></div><div class="rs-barre"><div style={`width:${a.pourcent}%`}></div></div></div>
            <p class="rs-insight">{a.fb.insight}</p><div class="rs-impact"><div class="chapeau-muet">Impact chiffré</div><p>{a.fb.impact}</p></div></section>
        ))}</div>
        <div class="rs-sortie"><div><h2>{s.titre}</h2><p class="seulement-desktop">{s.texte}</p><p class="seulement-mobile">{s.texte_court ?? s.texte}</p></div>
          <div class="rs-sortie-boutons">
            {A
              ? <><a href="/contact#reserver" class="btn btn-ecru">{s.cta}</a><a href="/contact#ecrire" class="btn btn-contour-ecru">{s.cta2}</a></>
              : <button type="button" class="btn btn-ecru" data-guide>{s.cta}</button>}
          </div></div>
        {A
          ? <div class="rs-guide"><div class="rs-guide-int"><div class="rs-guide-couv"></div><div><div class="rs-guide-titre">Les 10 erreurs fatales des vendeurs particuliers</div><div class="rs-guide-sous">Guide PDF, à la charte · A-10</div></div></div><button type="button" class="btn btn-secondaire btn-m" data-guide>Recevoir le guide</button></div>
          : <div class="rs-sequence"><p>{n(s.sequence)}</p><button type="button" class="btn btn-secondaire btn-m" data-sequence hidden={r.newsletter}>{s.sequence_cta}</button><span data-sequence-deja hidden={!r.newsletter} class="texte-muet" style="font-size:14px">Inscription à la séquence enregistrée.</span></div>}
        <div class="rs-etats" data-etats hidden>
          <div class="rs-etat-sequence" data-etat-guide hidden>Le guide est parti. Vérifiez {r.email}. Le lien de téléchargement est valable 7 jours. <a href="#" data-lien-guide target="_blank" rel="noopener">Ouvrir le guide maintenant</a></div>
          <div class="rs-etat-sequence" data-etat-sequence hidden>Séquence de {NOMBRE_ETAPES} e-mails confirmée. Le premier arrive {premier}. <a href={desabonnement}>Se désinscrire</a> à tout moment.</div>
          <div class="alerte" role="alert" data-etat-echec hidden>L'envoi n'a pas abouti. Réessayez dans un instant.</div>
        </div>
      </div>
    )}
  </div>
  <script>
    // Les deux actions de la page qui parlent au serveur, pour le lead de ce navigateur (cookie des résultats) :
    // inscription à la séquence (story 10.4) et envoi du guide par lien signé (story 10.5).
    const etats = document.querySelector<HTMLElement>('[data-etats]');
    const echec = document.querySelector<HTMLElement>('[data-etat-echec]');
    async function action(b: HTMLButtonElement, route: string, reussite: (r: { url?: string }) => void) {
      b.disabled = true; b.setAttribute('aria-busy', 'true');
      let r: { ok?: boolean; url?: string } = {};
      try { r = await (await fetch(route, { method: 'POST' })).json(); } catch { r = {}; }
      b.disabled = false; b.removeAttribute('aria-busy');
      etats!.hidden = false; echec!.hidden = r.ok === true;
      if (r.ok) reussite(r);
      etats!.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    const b = document.querySelector<HTMLButtonElement>('[data-sequence]');
    b?.addEventListener('click', () => action(b, '/api/diagnostic/sequence', () => {
      b.hidden = true;
      document.querySelector<HTMLElement>('[data-sequence-deja]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-etat-sequence]')!.hidden = false;
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-guide]').forEach((g) => g.addEventListener('click', () => action(g, '/api/diagnostic/guide', (r) => {
      const lien = document.querySelector<HTMLAnchorElement>('[data-lien-guide]')!;
      if (r.url) lien.href = r.url; else lien.hidden = true;
      document.querySelector<HTMLElement>('[data-etat-guide]')!.hidden = false;
    })));
  </script>
</Quiz>
<style is:global>
  .rs-expire { max-width: 560px; margin: 0 auto; padding: 48px var(--marge-m) 80px; display: flex; flex-direction: column; gap: 14px; }
  .rs-expire h1 { font-size: 28px; }
  .rs-expire p { font-size: 15px; line-height: 1.5; }
  .rs-refaire { text-align: center; font-size: 15px; }
  .rs-tete { padding: 64px var(--marge) 56px; display: grid; grid-template-columns: 420px 1fr; gap: 96px; align-items: center; border-bottom: 1px solid rgba(38, 32, 26, .1); }
  .rs-score { display: flex; align-items: baseline; gap: 8px; }
  .rs-score b { font-family: var(--avt-font-display); font-weight: 400; font-size: 160px; line-height: .9; }
  .rs-score span { font-size: 24px; }
  .rs-pastille { display: inline-block; border-radius: 999px; padding: 8px 16px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; margin-bottom: 18px; }
  .rs-profil-texte { font-family: var(--avt-font-display); font-size: 34px; line-height: 1.3; max-width: 30ch; }
  [data-ton="klein"] .rs-score b, [data-ton="klein"] .rs-barre > div { background-color: transparent; color: var(--avt-klein); }
  [data-ton="klein"] .rs-barre > div { background-color: var(--avt-klein); }
  [data-ton="klein"] .rs-pastille { background: var(--avt-brume); color: var(--avt-klein); }
  [data-ton="terra"] .rs-score b { color: var(--avt-terra-deep); }
  [data-ton="terra"] .rs-barre > div { background-color: var(--avt-terra-deep); }
  [data-ton="terra"] .rs-pastille { background: var(--avt-ecru); border: 1px solid var(--avt-galet); color: var(--avt-terra-deep); } /* maquette : fond galet (4,35:1) → écru bordé pour ≥ 4,5:1 */
  [data-ton="brun"] .rs-score b { color: var(--avt-brun); }
  [data-ton="brun"] .rs-barre > div { background-color: var(--avt-brun); }
  [data-ton="brun"] .rs-pastille { background: var(--avt-brun); color: var(--avt-ecru); }
  .rs-axes { padding: 56px var(--marge); display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 32px; }
  .rs-axe { display: flex; flex-direction: column; gap: 18px; }
  .rs-axe .chapeau { margin-bottom: 8px; }
  .rs-sous { display: flex; align-items: baseline; gap: 8px; }
  .rs-sous b { font-family: var(--avt-font-display); font-weight: 400; font-size: 48px; line-height: 1; }
  .rs-sous span { font-size: 15px; color: var(--avt-text-muted); }
  .rs-barre { height: 4px; background: var(--avt-galet); border-radius: 2px; margin-top: 8px; }
  .rs-barre > div { height: 100%; border-radius: 2px; }
  .rs-insight { font-size: 15.5px; line-height: 1.6; }
  .rs-impact { background: var(--avt-brume); border-radius: 12px; padding: 18px 20px; }
  .rs-impact .chapeau-muet { margin-bottom: 6px; }
  .rs-impact p { font-size: 15px; line-height: 1.5; }
  .rs-sortie { margin: 0 var(--marge) 40px; background: var(--avt-klein); color: var(--avt-ecru); border-radius: 16px; padding: 56px; display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .rs-sortie h2 { font-size: 40px; color: var(--avt-ecru); margin-bottom: 16px; }
  .rs-sortie p { font-size: 17px; line-height: 1.6; max-width: 60ch; }
  .rs-sortie-boutons { display: flex; flex-direction: column; gap: 12px; }
  .rs-guide { margin: 0 var(--marge) 96px; display: flex; align-items: center; justify-content: space-between; gap: 32px; border: 1px solid var(--filet-brun-fort); border-radius: 16px; padding: 28px 36px; }
  .rs-guide-int { display: flex; align-items: center; gap: 24px; }
  .rs-guide-couv { width: 64px; height: 84px; background: var(--avt-galet); border-radius: 4px; flex: none; }
  .rs-guide-titre { font-family: var(--avt-font-display); font-size: 26px; }
  .rs-guide-sous { font-size: 14px; color: var(--avt-text-muted); }
  .rs-sequence { margin: 0 var(--marge) 96px; display: flex; align-items: center; justify-content: space-between; gap: 32px; border: 1px solid var(--filet-brun-fort); border-radius: 16px; padding: 28px 36px; font-size: 16px; line-height: 1.5; }
  .rs-sequence p { max-width: 60ch; }
  .rs-etats { margin: 0 var(--marge) 96px; display: flex; flex-direction: column; gap: 14px; max-width: 560px; }
  .rs-etat-sequence { border: 1px solid var(--filet-brun-fort); border-radius: 14px; padding: 18px 20px; font-size: 14.5px; line-height: 1.5; }
  @media (max-width: 899px) {
    .rs-tete { padding: 24px var(--marge-m) 28px; display: block; border-bottom: 0; }
    .rs-score b { font-size: 96px; }
    .rs-score span { font-size: 18px; }
    .rs-pastille { padding: 7px 14px; font-size: 12px; margin: 18px 0 12px; }
    .rs-profil-texte { font-family: var(--avt-font-text); font-size: 16px; line-height: 1.5; }
    .rs-axes { padding: 0; display: block; }
    .rs-resume { padding: 0 var(--marge-m) 28px; display: flex; flex-direction: column; gap: 14px; }
    .rs-resume > div { border-top: 1px solid rgba(38, 32, 26, .1); padding-top: 12px; }
    .rs-resume-rang { display: flex; justify-content: space-between; align-items: baseline; }
    .rs-resume-rang span { font-size: 14px; }
    .rs-resume-rang b { font-family: var(--avt-font-display); font-weight: 400; font-size: 26px; }
    .rs-resume-rang b small { font: 400 13px var(--avt-font-text); color: var(--avt-text-muted); }
    .rs-axe { padding: 28px var(--marge-m); gap: 14px; }
    .rs-axe:nth-child(odd) { background: var(--avt-galet); }
    .rs-axe:nth-child(odd) .rs-impact { background: var(--avt-ecru); }
    .rs-axe .rs-sous, .rs-axe .rs-barre { display: none; }
    .rs-axe .chapeau { margin-bottom: 0; }
    .rs-insight { font-size: 15px; line-height: 1.55; }
    .rs-impact { padding: 14px 16px; }
    .rs-impact p { font-size: 14.5px; }
    .rs-sortie { margin: 28px var(--marge-m); padding: 28px 22px; display: flex; flex-direction: column; gap: 14px; }
    .rs-sortie h2 { font-size: 28px; margin-bottom: 0; }
    .rs-sortie p { font-size: 15.5px; line-height: 1.55; }
    .rs-guide, .rs-sequence { margin: 0 var(--marge-m) 32px; border-radius: 14px; padding: 20px; flex-direction: column; align-items: stretch; gap: 14px; }
    .rs-guide-int { gap: 14px; }
    .rs-guide-couv { width: 44px; height: 58px; }
    .rs-guide-titre { font-size: 20px; }
    .rs-etats { margin: 0 var(--marge-m) 40px; }
  }
  @media (min-width: 900px) { .rs-resume { display: none; } }
</style>
