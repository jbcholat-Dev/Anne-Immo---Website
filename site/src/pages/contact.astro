---
// 10 Contact / Rendez-vous (§ 9, CAP-9) : deux chemins — l'agenda réel d'Anne (Cal.com, story 10.6) et « Écrire à Anne ».
// Le premier rendez-vous se fait par téléphone, Anne appelle (décision de JB du 2026-10-08).
import Page from '../layouts/Page.astro';
import FormulaireContact from '../components/FormulaireContact.astro';
import { textes, court } from '../lib/textes';
// Textes modifiables par Anne : contenu-anne/textes/contact.yml (story 7.20).
const x = await textes('contact');
---
<Page titre={`Contact — ${x.titre} — Anne VIAL-TISSOT`} description={x.description} courante="contact">
  <div class="ct-tete">
    <h1>{x.titre}</h1>
    <p><span class="seulement-desktop">{x.intro}</span><span class="seulement-mobile">{court(x.intro_court, x.intro)}</span></p>
  </div>
  <div class="ct-corps">
    <section aria-label={x.rendez_vous.titre} class="ct-rdv" id="reserver" data-rdv>
      <h2>{x.rendez_vous.titre}</h2>
      <p class="ct-rdv-sous">{x.rendez_vous.texte}</p>
      <!-- L'agenda Cal.com (service de prise de rendez-vous) ne se charge qu'au clic, ou à l'arrivée depuis un bouton « Réserver » (AD-11).
           Cal.com verrouille le créneau, demande l'accord sur la politique de confidentialité et envoie les confirmations ;
           le site enregistre chaque réservation par le webhook /api/webhook-cal (src/server/adapters/booking.ts). -->
      <div class="ct-agenda" data-agenda>
        <button type="button" class="btn btn-primaire ct-agenda-bouton" data-agenda-ouvrir data-libelle={x.rendez_vous.bouton}>{x.rendez_vous.bouton}</button>
        <p class="texte-muet ct-agenda-note">L'agenda est fourni par Cal.com. <a href="/confidentialite">Confidentialité</a>.</p>
      </div>
      <div class="ct-agenda-cadre" id="agenda-cal" data-agenda-cadre hidden></div>
      <div class="alerte" role="alert" data-agenda-echec hidden>L'agenda ne s'est pas chargé. Réessayez, ou écrivez à Anne avec le formulaire.</div>
    </section>
    <FormulaireContact projet="vente" />
  </div>
  <script src="../islands/formulaires.ts"></script>
  <script>
    // Agenda Cal.com (story 10.6) : le script de Cal.com n'est chargé qu'à la demande du visiteur (AD-11). Arriver par un lien
    // « Réserver » (#reserver, depuis les résultats du diagnostic par exemple) vaut demande. Lien Cal.com : cal.com/annevialtissot/premier-echange.
    const CAL_LIEN = 'annevialtissot/premier-echange';
    const ouvrir = document.querySelector<HTMLButtonElement>('[data-agenda-ouvrir]');
    const cadre = document.querySelector<HTMLElement>('[data-agenda-cadre]');
    const echecAgenda = document.querySelector<HTMLElement>('[data-agenda-echec]');
    type CalApi = ((...a: unknown[]) => void) & { ns: Record<string, (...a: unknown[]) => void>; loaded?: boolean; q?: unknown[] };
    function chargerAgenda() {
      if (!ouvrir || !cadre || cadre.dataset.charge) return;
      cadre.dataset.charge = '1';
      ouvrir.setAttribute('aria-busy', 'true'); ouvrir.disabled = true; ouvrir.textContent = 'Chargement de l’agenda…';
      // Chargeur officiel de Cal.com (embed « inline »), réécrit lisiblement.
      const w = window as unknown as { Cal?: CalApi };
      const file = (api: { q: unknown[] }, args: unknown) => api.q.push(args);
      const cal = function (this: unknown, ...args: unknown[]) {
        const c = w.Cal!;
        if (!c.loaded) {
          c.ns = {}; c.q = c.q || [];
          const s = document.createElement('script');
          s.src = 'https://app.cal.com/embed/embed.js';
          s.onerror = () => { delete w.Cal; cadre.hidden = true; delete cadre.dataset.charge; if (echecAgenda) echecAgenda.hidden = false; ouvrir.disabled = false; ouvrir.removeAttribute('aria-busy'); ouvrir.textContent = ouvrir.dataset.libelle ?? ''; };
          document.head.append(s);
          c.loaded = true;
        }
        if (args[0] === 'init') {
          const api = Object.assign((...a: unknown[]) => file(api, a), { q: [] as unknown[] });
          const ns = args[1] as string;
          c.ns[ns] = c.ns[ns] || api;
          file(c.ns[ns] as unknown as { q: unknown[] }, args);
          file(c as unknown as { q: unknown[] }, ['initNamespace', ns]);
          return;
        }
        file(c as unknown as { q: unknown[] }, args);
      } as CalApi;
      w.Cal = w.Cal || cal;
      w.Cal('init', 'rdv', { origin: 'https://cal.com' });
      cadre.hidden = false;
      w.Cal.ns.rdv('inline', { elementOrSelector: '#agenda-cal', calLink: CAL_LIEN, config: { layout: 'month_view' } });
      w.Cal.ns.rdv('ui', { hideEventTypeDetails: true, layout: 'month_view', cssVarsPerTheme: { light: { 'cal-brand': '#002FA7' }, dark: { 'cal-brand': '#002FA7' } } });
      w.Cal.ns.rdv('on', { action: 'linkReady', callback: () => { ouvrir.closest('[data-agenda]')?.setAttribute('hidden', ''); } });
    }
    ouvrir?.addEventListener('click', chargerAgenda);
    if (location.hash === '#reserver') chargerAgenda();
    if (new URLSearchParams(location.search).get('projet') === 'achat') {
      const r = document.querySelector<HTMLInputElement>('input[name="projet"][value="achat"]');
      if (r) r.checked = true;
    }
  </script>
</Page>
<style>
  .ct-tete { padding: 80px var(--marge) 32px; }
  .ct-tete h1 { font-size: 72px; margin-bottom: 14px; }
  .ct-tete p { font-size: 18px; line-height: 1.6; max-width: 56ch; }
  .ct-corps { padding: 32px var(--marge) 96px; display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: start; }
  .ct-rdv { background: var(--avt-galet); border-radius: 16px; padding: 36px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .ct-rdv h2 { font-size: 32px; margin-bottom: 6px; }
  .ct-agenda { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ct-agenda-bouton { min-height: 56px; }
  .ct-agenda-note { font-size: 13.5px; }
  .ct-agenda-cadre { min-height: 560px; background: var(--avt-ecru); border-radius: 12px; overflow: hidden; }
  .ct-rdv-sous { font-size: 14px; color: var(--avt-text-muted); margin-bottom: 24px; }
  .ct-large { grid-column: 1 / -1; }
  @media (max-width: 899px) {
    .ct-tete { padding: 40px var(--marge-m) 24px; }
    .ct-tete h1 { font-size: 44px; margin-bottom: 10px; }
    .ct-tete p { font-size: 16px; }
    .ct-corps { padding: 0 0 40px; display: block; }
    .ct-rdv { margin: 0 16px 28px; border-radius: 14px; padding: 22px 18px; }
    .ct-rdv h2 { font-size: 26px; margin-bottom: 14px; }
    .ct-corps :global(.fc) { padding: 0 var(--marge-m); }
  }
</style>
