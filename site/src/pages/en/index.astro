---
// EN home (AD-2, AD-3) : same composition as the French home. No story is translated yet, so § 1.3 (the sticky pile) is not published in English
// (« aucune story publiée — la section disparaît »). Reviews are quoted in their original language, marked as such.
import Page from '../../layouts/Page.astro';
import Hero from '../../components/accueil/Hero.astro';
import BandePreuve from '../../components/accueil/BandePreuve.astro';
