---
// Programme ambassadeurs (epic 17, story 17.2) : la page où mène le QR code des cartes, dépliants et flyers d'Anne
// (`?c=carte`, `?c=depliant`, `?c=flyer` : l'origine est gardée avec l'inscription). Maquette validée par JB le 2026-11-05 :
// https://claude.ai/artifact/JRzaQnTFGuTM83oyuFdHby (titre « Tu connais un bon agent immobilier ? », texte « accroche,
// histoire, offre »). L'inscription passe par le traitement commun des formulaires (/api/ambassadeurs, capture.ts) ; la
// recommandation d'un proche, elle, ne passe jamais par le site : l'inscrit écrit à Anne (WhatsApp, SMS ou e-mail).
// Page non indexée tant que le programme n'est pas ouvert (story 17.4 : accord d'eXp France).
import Page from '../layouts/Page.astro';
import Picture from '../components/Picture.astro';
import Champ from '../components/Champ.astro';
import Case from '../components/Case.astro';
import ChampPiege from '../components/ChampPiege.astro';
import { telephone } from '../config/site';
const numero = telephone.lien.replace('tel:', '');
const message = encodeURIComponent("Bonjour Anne, je viens de m'inscrire comme ambassadeur. Je voudrais vous présenter quelqu'un : ");
const whatsapp = `https://wa.me/${numero.replace('+', '')}?text=${message}`;
const sms = `sms:${numero}?&body=${message}`;
const etapes = [
  ['Vous vous inscrivez', 'Quatre champs, juste en dessous. Vous recevez le lien du règlement par e-mail.'],
  ['Vous me donnez un nom', "Un message suffit : le prénom et le numéro d'un proche qui pense à vendre, avec son accord."],
  ['Je vous remercie', 'Si la vente se fait avec moi, dans le mois qui suit la signature chez le notaire.'],
];
const questions = [
  ['Qui peut être ambassadeur ?', "Toute personne majeure, que je l'aie déjà accompagnée ou non. Vous êtes notaire, artisan ou banquier ? Parlons plutôt d'un échange de recommandations."],
  ['Quelles ventes comptent ?', "La vente d'une maison, d'un appartement ou d'un terrain, qu'on me confie en exclusivité. Votre proche ne doit pas déjà être en contact avec moi pour ce bien."],
  ['Dois-je faire autre chose ?', 'Non. Vous présentez, c’est tout : pas de visite, pas de discussion de prix. Trois remerciements par an au plus.'],
  ['Faut-il déclarer la somme ?', 'Oui, dans vos revenus, comme toute somme de ce type. Le règlement complet explique tout.'],
];
---
<Page titre="Programme ambassadeurs — Anne VIAL-TISSOT" description="Présentez-moi un proche qui vend : si la vente se fait, je vous remercie, jusqu'à 1 500 €." noindex sansPadding>
  <div data-amb-page>
  <section class="am-haut">
    <div class="am-texte">
      <div class="am-sur">
        <Picture id="pages/a-propos/jyhell-2023-104" alt="" sizes="56px" class="am-pastille" />
        <p class="am-etiquette">Mon programme ambassadeurs</p>
      </div>
      <h1>« Tu connais un bon agent immobilier ? »</h1>
      <svg class="am-trait" width="200" height="14" viewBox="0 0 160 12" aria-hidden="true"><path d="M2 8 C40 2 90 10 158 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
      <p>Mes plus belles ventes ont commencé par une phrase : « Appelle Anne de ma part. » Une voisine, un ancien client, un ami d'ami.</p>
      <p>Ces personnes m'ont fait confiance. Aujourd'hui, je veux les remercier comme il se doit.</p>
      <p>Présentez-moi un proche qui vend. Si la vente se fait : <strong>jusqu'à 1 500 € pour vous</strong>.</p>
      <div class="am-appel">
        <a href="#inscription" class="btn btn-primaire">Devenir ambassadeur</a>
        <p class="texte-muet">Inscription en 30 secondes. Aucun engagement.</p>
      </div>
    </div>
    <div class="am-photo">
      <Picture id="pages/a-propos/jyhell-2023-104" alt="Anne VIAL-TISSOT" sizes="560px" class="am-portrait" />
      <div class="am-legende"><p class="am-legende-nom">Anne VIAL-TISSOT</p><p>Conseil immobilier, Léman et Chablais</p></div>
    </div>
  </section>

  <section class="am-etapes" aria-labelledby="am-etapes-titre">
    <p class="am-etiquette">Comment ça marche</p>
    <h2 id="am-etapes-titre">Trois étapes, un seul rôle : <span class="am-bleu">présenter</span></h2>
    <ol>
      {etapes.map(([titre, texte], i) => (
        <li><span class="am-num" aria-hidden="true">{i + 1}</span><div><p class="am-etape-titre">{titre}</p><p class="texte-muet">{texte}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="am-inscription" id="inscription" aria-label="Rejoindre les ambassadeurs">
    <div class="am-gauche">
      <div class="am-merci">
        <p class="am-etiquette">Votre remerciement</p>
        <p class="am-montant">jusqu'à 1 500 €</p>
        <p>5 % des honoraires hors taxes de l'agence sur la vente, dans la limite de 1 500 €. Virement ou carte cadeau voyage, au choix.</p>
      </div>
      <p class="texte-muet am-donnees">Vos coordonnées servent seulement à ce programme et ne sont jamais revendues. <a href="/confidentialite">Politique de confidentialité</a>.</p>
    </div>
    <div class="am-droite">
      <form data-formulaire="ambassadeurs" novalidate>
        <h2>Rejoindre les ambassadeurs</h2>
        <div class="am-champs">
          <Champ nom="prenom" label="Prénom" requis autocomplete="given-name" erreur="Indiquez votre prénom." />
          <Champ nom="nom" label="Nom" requis autocomplete="family-name" erreur="Indiquez votre nom." />
          <Champ nom="telephone" label="Téléphone" type="tel" requis autocomplete="tel" inputmode="tel" erreur="Dix chiffres attendus." />
          <Champ nom="email" label="E-mail" type="email" requis autocomplete="email" erreur="Indiquez votre adresse e-mail." />
        </div>
        <Case nom="reglement" requis message="Nécessaire pour vous inscrire.">J'ai lu et j'accepte le <a href="/ambassadeurs/reglement" target="_blank">règlement du programme</a> et la <a href="/confidentialite">politique de confidentialité</a>. Je suis majeur et je ne suis pas un professionnel de l'immobilier. Obligatoire.</Case>
        <Case nom="newsletter">Recevoir de mes nouvelles par e-mail, quelques fois par an. Facultatif.</Case>
        <input type="hidden" name="c" value="" data-origine />
        <ChampPiege />
        <div class="alerte-douce" data-erreurs-globales hidden role="alert"></div>
        <div data-echec hidden tabindex="-1"><div class="alerte" role="alert">L'inscription n'a pas abouti. Vos informations sont conservées : rien à ressaisir.</div></div>
        <button type="submit" class="btn btn-primaire am-bouton">Devenir ambassadeur</button>
      </form>
    </div>
  </section>

  <section class="am-faq" aria-labelledby="am-faq-titre">
    <p class="am-etiquette" id="am-faq-titre">Bon à savoir</p>
    <div class="am-grille">
      {questions.map(([q, r]) => <div class="am-q"><p class="am-q-titre">{q}</p><p class="texte-muet">{r}</p></div>)}
    </div>
    <a href="/ambassadeurs/reglement" class="am-lien">Lire le règlement complet →</a>
  </section>
  </div>

  <section class="am-fini" data-confirmation="ambassadeurs" hidden>
    <div class="am-fini-dedans">
      <p class="am-etiquette">C'est fait</p>
      <h1 class="am-fini-titre" data-titre-neuf>Bienvenue parmi les ambassadeurs, <span class="am-bleu" data-champ="prenom"></span>.</h1>
      <h1 class="am-fini-titre" data-titre-deja hidden>Vous êtes déjà ambassadeur, <span class="am-bleu" data-champ="prenom"></span>.</h1>
      <svg class="am-trait" width="200" height="14" viewBox="0 0 160 12" aria-hidden="true"><path d="M2 8 C40 2 90 10 158 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
      <p data-texte-neuf>J'ai bien reçu votre inscription. Le règlement vient de partir à <strong data-champ="email"></strong>.</p>
      <p data-texte-deja hidden>Votre inscription est déjà enregistrée : vous n'avez rien à refaire.</p>
      <div class="am-carte">
        <h3>Vous pensez déjà à quelqu'un ?</h3>
        <p class="texte-muet">Demandez-lui d'abord son accord. Ensuite, envoyez-moi son prénom et son numéro.</p>
        <div class="am-actions">
          <a href={whatsapp} class="btn btn-primaire" target="_blank" rel="noopener">M'écrire sur WhatsApp</a>
          <a href={sms} class="btn btn-secondaire">M'envoyer un SMS</a>
        </div>
      </div>
      <a href="/anne-vial-tissot.vcf" class="am-lien">Enregistrer mon numéro dans votre téléphone →</a>
      <p class="texte-muet am-plus-tard">Pas de nom en tête pour l'instant ? Je reste joignable au même numéro : <a href={telephone.lien}>{telephone.affiche}</a>.</p>
    </div>
  </section>
</Page>

<script>
  // L'origine imprimée (`?c=carte`…) suit l'inscription. « Déjà ambassadeur » : la réponse du serveur change la confirmation.
  const form = document.querySelector<HTMLFormElement>('form[data-formulaire="ambassadeurs"]');
  if (form) {
    const origine = new URLSearchParams(location.search).get('c') ?? '';
    const champC = form.querySelector<HTMLInputElement>('[data-origine]');
    if (champC) champC.value = origine.slice(0, 40);
    form.addEventListener('avt:reponse', (e) => {
      const deja = (e as CustomEvent<{ deja?: boolean }>).detail?.deja === true;
      const conf = document.querySelector<HTMLElement>('[data-confirmation="ambassadeurs"]');
      conf?.querySelectorAll<HTMLElement>('[data-titre-neuf], [data-texte-neuf]').forEach((el) => { el.hidden = deja; });
      conf?.querySelectorAll<HTMLElement>('[data-titre-deja], [data-texte-deja]').forEach((el) => { el.hidden = !deja; });
      // Retour de JB (2026-11-08) : la confirmation remplace toute la page, comme l'écran 2 de la maquette, pour qu'on ne
      // la manque pas. L'îlot affiche ensuite la confirmation et la centre ; on remonte en haut juste après.
      document.querySelector<HTMLElement>('[data-amb-page]')?.setAttribute('hidden', '');
      requestAnimationFrame(() => requestAnimationFrame(() => window.scrollTo({ top: 0, behavior: 'instant' })));
    });
  }
</script>
<script src="../islands/formulaires.ts"></script>

<style>
  .am-etiquette { margin: 0; font-size: 13px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--avt-klein); }
  .am-bleu { color: var(--avt-klein); }
  .am-haut { padding: 104px 20px 40px; display: flex; flex-direction: column; gap: 32px; }
  .am-texte { display: flex; flex-direction: column; gap: 16px; }
  .am-sur { display: flex; align-items: center; gap: 12px; }
  .am-sur :global(.am-pastille), .am-sur :global(.am-pastille img) { width: 56px; height: 56px; border-radius: 999px; object-fit: cover; object-position: 62% 22%; display: block; }
  .am-haut h1 { margin: 0; font-size: 34px; line-height: 1.14; }
  .am-trait { color: var(--avt-terra); width: 160px; height: 12px; }
  .am-texte > p { margin: 0; font-size: 17px; line-height: 1.6; }
  .am-texte strong { font-weight: 500; color: var(--avt-klein); }
  .am-appel { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 4px; }
  .am-appel p { margin: 0; font-size: 14px; }
  .am-photo { display: none; }
  .am-etapes { padding: 40px 20px; background: #FFFDF9; display: flex; flex-direction: column; gap: 16px; }
  .am-etapes h2 { margin: 0; font-size: 30px; line-height: 1.2; }
  .am-etapes ol { margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 18px; }
  .am-etapes li { display: flex; gap: 14px; }
  .am-num { flex: none; width: 36px; height: 36px; border-radius: 999px; background: var(--avt-brume); color: var(--avt-klein); font-family: var(--avt-font-display); font-size: 19px; display: flex; align-items: center; justify-content: center; }
  .am-etape-titre { margin: 0; font-weight: 500; }
  .am-etapes li .texte-muet { margin: 0; font-size: 15px; }
  .am-inscription { padding: 40px 20px; display: flex; flex-direction: column; gap: 28px; }
  .am-gauche { display: flex; flex-direction: column; gap: 16px; }
  .am-merci { background: var(--avt-brume); border-radius: 12px; padding: 22px 20px; display: flex; flex-direction: column; gap: 8px; }
  .am-merci p { margin: 0; font-size: 15px; }
  .am-montant { font-family: var(--avt-font-display); font-size: 40px !important; line-height: 1.05; color: var(--avt-klein); }
  .am-donnees { margin: 0; font-size: 14px; }
  .am-droite form { display: flex; flex-direction: column; gap: 14px; }
  .am-droite h2 { margin: 0 0 4px; font-size: 30px; line-height: 1.2; }
  .am-champs { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .am-bouton { align-self: stretch; min-height: 56px; }
  [data-amb-page][hidden], .am-fini[hidden], .am-fini [hidden] { display: none; }
  .am-fini { padding: 104px 20px 64px; min-height: 80vh; }
  .am-fini-dedans { max-width: 640px; display: flex; flex-direction: column; gap: 16px; outline: none; }
  .am-fini-titre { margin: 0; font-size: 34px; line-height: 1.14; }
  .am-fini-dedans > p { margin: 0; font-size: 17px; line-height: 1.6; }
  .am-fini strong { font-weight: 500; }
  .am-carte { background: var(--avt-galet); border-radius: 16px; padding: 22px 20px; display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .am-carte h3 { margin: 0; font-size: 26px; line-height: 1.2; }
  .am-carte p { margin: 0; font-size: 15px; line-height: 1.5; }
  .am-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .am-actions .btn { justify-content: center; }
  .am-plus-tard { margin-top: 24px !important; font-size: 15px !important; }
  .am-faq { padding: 8px 20px 56px; display: flex; flex-direction: column; gap: 14px; }
  .am-grille { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .am-q { border-top: 1px solid rgba(38, 32, 26, .12); padding-top: 14px; }
  .am-q-titre { margin: 0; font-weight: 500; }
  .am-q .texte-muet { margin: 4px 0 0; font-size: 15px; }
  .am-lien { font-size: 15px; color: var(--avt-klein); }
  @media (min-width: 900px) {
    .am-haut { padding: calc(160 * var(--px-h)) 120px calc(88 * var(--px-h)); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 72px; align-items: center; }
    .am-sur :global(.am-pastille) { display: none; }
    .am-haut h1 { font-size: calc(56 * var(--px-h)); line-height: 1.1; }
    .am-trait { width: 200px; height: 14px; }
    .am-texte > p { font-size: 19px; max-width: 560px; }
    .am-appel { flex-direction: row; align-items: center; gap: 20px; margin-top: 8px; }
    .am-appel p { font-size: 15px; }
    .am-photo { display: block; position: relative; }
    .am-photo :global(.am-portrait), .am-photo :global(.am-portrait img) { display: block; width: 100%; height: 560px; border-radius: 24px; object-fit: cover; object-position: 62% 22%; }
    .am-legende { position: absolute; left: -32px; bottom: 32px; background: var(--avt-ecru); border-radius: 16px; padding: 16px 22px; box-shadow: 0 8px 24px rgba(38, 32, 26, .12); }
    .am-legende p { margin: 0; font-size: 14px; color: var(--avt-text-muted); }
    .am-legende .am-legende-nom { font-family: var(--avt-font-display); font-size: 20px; color: var(--avt-brun); }
    .am-etapes { padding: calc(72 * var(--px-h)) 120px; gap: 10px; }
    .am-etapes h2 { font-size: calc(40 * var(--px-h)); }
    .am-etapes ol { margin-top: 26px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .am-etapes li { flex-direction: column; gap: 12px; border-top: 1px solid rgba(38, 32, 26, .12); padding-top: 24px; }
    .am-num { width: 44px; height: 44px; font-size: 22px; }
    .am-etape-titre { font-size: 19px; }
    .am-inscription { padding: calc(88 * var(--px-h)) 120px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; align-items: start; }
    .am-merci { border-radius: 16px; padding: 32px; }
    .am-merci p { font-size: 16px; }
    .am-montant { font-size: calc(56 * var(--px-h)) !important; }
    .am-donnees { font-size: 16px; }
    .am-droite h2 { font-size: calc(40 * var(--px-h)); }
    .am-champs { grid-template-columns: 1fr 1fr; gap: 16px; }
    .am-bouton { align-self: flex-start; padding: 0 36px; }
    .am-faq { padding: 0 120px calc(88 * var(--px-h)); gap: 24px; }
    .am-fini { padding: calc(168 * var(--px-h)) 120px calc(96 * var(--px-h)); }
    .am-fini-titre { font-size: calc(56 * var(--px-h)); line-height: 1.1; }
    .am-fini-dedans > p { font-size: 19px; }
    .am-carte { padding: 32px; }
    .am-carte h3 { font-size: 32px; }
    .am-actions { flex-direction: row; }
    .am-grille { grid-template-columns: 1fr 1fr; gap: 24px 72px; }
  }
</style>
