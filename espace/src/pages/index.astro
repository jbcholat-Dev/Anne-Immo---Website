---
// Contacts (story 18.4, FR-1, FR-3, FR-14 ; maquette `ux-espace-anne-2026-11-01`) : la page d'accueil de l'espace. Un
// grand tableau, une ligne par contact non effacé, du carnet comme du suivi des ventes ; les écartés sont masqués.
// Le serveur lit tout une fois (`lireTableau`, AD-27) et l'envoie dans la page ; l'îlot ci-dessous trie, cherche et
// masque et réordonne des colonnes dans le navigateur (choix et ordre des colonnes gardés dans ce navigateur), sans revenir au serveur.
// Story 18.5 : filtres (FR-2, plus « à rappeler », vocabulaire fermé d'AD-27 dans `server/vues.ts`) dans la barre
// d'outils, pastilles des filtres actifs au-dessus du tableau, vues enregistrées et catégories dans la colonne de gauche ;
// les vues s'écrivent par /api/vues. Recherche et filtres lisent un index calculé une fois au chargement.
// Story 18.6 : une case à cocher par ligne (Maj + clic coche la plage, case d'en-tête pour toutes les lignes affichées),
// barre d'actions groupées (catégorie, projet, température, vérifié, écarter ou faire revenir) et classement d'une seule
// ligne dans ses cellules ; tout s'écrit par /api/carnet (`server/carnet`, avant-image gardée, AD-29) et s'annule depuis
// le message qui suit. Le tableau se met à jour sans recharger.
// Story 18.7 : un clic sur le nom ouvre la fiche du contact dans un panneau à droite (`islands/fiche-contact`, /api/fiche) ;
// « + Nouveau contact » en haut à droite ouvre la saisie de la maquette. La ligne écrite revient dans le tableau sans
// recharger ; `/?fiche=<id>` ouvre la page avec la fiche ouverte.
// Story 18.8 : sous les catégories, un lien vers « Catégories et méthodes » (/categories).
// Story 18.11 : la barre « Nouveaux » au-dessus de la recherche (`islands/nouveaux`, /api/nouveaux) : les demandes
// reçues pas encore vues (site, numéros inconnus de Leedflow), dépliées d'un clic, chacune avec ses gestes et l'annulation.
// L'ancienne page d'accueil « Aujourd'hui » est à /aujourdhui ; ses anciens retours (`/?m=…`) y sont renvoyés.
import Espace from '../layouts/Espace.astro';
import { ENTETE_COMPTE } from '@site/server/acces';
import { pourSite as env } from '../server/env';
import { lireCategories, lireTableau } from '../server/tableau';
import { ACCORDS, COLONNES, ETATS_AMBASSADEUR, PROJETS, TEMPERATURES, TEMPERATURES_CHOIX } from '../server/tableau-colonnes';
import { DUREES } from '../server/vues';
import { listerVues } from '../server/vues-base';
import { lireNouveaux } from '../server/nouveaux';
import { envEspace } from '../server/env';

export const prerender = false;
if (!Astro.request.headers.get(ENTETE_COMPTE)) return new Response('Accès refusé', { status: 403 });
const m = Astro.url.searchParams.get('m') ?? '';
if (['suite', 'tache-acceptee', 'tache-ignoree'].includes(m)) return Astro.redirect(`/aujourdhui?m=${m}`, 302);

const [lignes, vues, categories, nouveaux] = await Promise.all([lireTableau(env), listerVues(env), lireCategories(env), lireNouveaux(envEspace)]);
const total = lignes.filter((l) => !l.ecarte).length;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
// Dans un <script type="application/json"> : « < » échappé, pour qu'aucun texte saisi ne ferme la balise.
const enJson = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const donnees = enJson(lignes);
const reglages = enJson({ vues, categories });
const donneesNouveaux = enJson(nouveaux);
---
<Espace titre="Contacts" actif="contacts" large>
  <div class="ct-tete">
    <div><h1>Contacts</h1><div class="e-muet">Tous les contacts d'Anne, toutes sources confondues.</div></div>
    <button type="button" class="ct-btn bleu ct-nouveau" data-nouveau-contact>+ Nouveau contact</button>
  </div>
  <div class="ct-page">
    <aside class="ct-cote" aria-label="Vues et catégories">
      <div class="ct-bloc">
        <h3>Vues</h3>
        <div data-vues>
          <div class="ct-vue-l"><button type="button" class="ct-vue actif" data-vue="tous" aria-pressed="true"><span>Tous les contacts</span><small>{total}</small></button></div>
          {vues.map((v) => <div class="ct-vue-l"><button type="button" class="ct-vue" data-vue={v.id} aria-pressed="false"><span>{v.nom}</span></button></div>)}
        </div>
        <button type="button" class="ct-btn ct-nouvelle" data-nouvelle-vue>+ Nouvelle vue avec ces filtres</button>
      </div>
      <div class="ct-bloc">
        <h3>Catégories</h3>
        <div data-categories></div>
        <a href="/categories" class="ct-gerer" data-gerer-categories>Catégories et méthodes</a>
      </div>
    </aside>
    <div class="ct-principal">
      <section class="nv" data-nouveaux aria-label="Nouvelles demandes">
        <button type="button" class="nv-barre" data-nv-barre aria-expanded="false" aria-controls="nv-liste">
          <span class="nv-pastille" data-nv-compte>{nouveaux.total}</span><strong>Nouveaux</strong><span class="nv-src" data-nv-src></span><span class="nv-chev" aria-hidden="true">▾</span>
        </button>
        <div class="nv-liste" id="nv-liste" data-nv-liste hidden></div>
      </section>
      <div class="ct-outils">
        <input type="search" data-recherche value={q} placeholder="Nom, numéro, e-mail, entreprise…" aria-label="Rechercher un contact" autocomplete="off" />
        <details class="ct-menu" data-colonnes>
          <summary>Colonnes</summary>
          <div class="ct-menu-liste" data-colonnes-liste>
            {COLONNES.filter((c) => c.masquable).map((c) => (
              <div class="ct-col" data-col={c.cle}>
                <label><input type="checkbox" value={c.cle} checked /> {c.libelle}</label>
                <button type="button" class="ct-col-b" data-monter aria-label={`Monter la colonne ${c.libelle}`}>▲</button>
                <button type="button" class="ct-col-b" data-descendre aria-label={`Descendre la colonne ${c.libelle}`}>▼</button>
              </div>
            ))}
          </div>
        </details>
      </div>
      <div class="ct-filtres" data-filtres>
        <select data-filtre="categorie_id" aria-label="Filtrer par catégorie"><option value="">Catégorie</option>{categories.map((c) => <option value={c.id}>{c.nom}</option>)}</select>
        <select data-filtre="projet" aria-label="Filtrer par projet"><option value="">Projet</option>{Object.entries(PROJETS).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        <select data-filtre="temperature" aria-label="Filtrer par température"><option value="">Température</option>{Object.entries(TEMPERATURES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        <select data-filtre="source" aria-label="Filtrer par source"><option value="">Source</option></select>
        <select data-filtre="ville" aria-label="Filtrer par ville"><option value="">Ville</option></select>
        <select data-filtre="lieu" aria-label="Filtrer par lieu de rencontre"><option value="">Lieu de rencontre</option></select>
        <select data-filtre="mois" aria-label="Filtrer par mois de rencontre"><option value="">Mois de rencontre</option></select>
        <input type="search" data-filtre-texte="entreprise_contient" placeholder="Entreprise contient…" aria-label="Filtrer par entreprise (contient)" autocomplete="off" />
        <select data-filtre="dernier_contact" aria-label="Filtrer par dernier contact"><option value="">Dernier contact</option><option value="jamais">Jamais recontacté</option>{DUREES.map((d) => <option value={d.jours}>{d.libelle.charAt(0).toUpperCase() + d.libelle.slice(1)}</option>)}</select>
        <select data-filtre="etat" aria-label="Filtrer par état"><option value="">État</option><option value="verifie:non">À vérifier</option><option value="verifie:oui">Vérifiés</option><option value="ecarte:oui">Écartés</option></select>
        <select data-filtre="autres" aria-label="Autres filtres"><option value="">Autres filtres</option>
          <optgroup label="Accord e-mail">{Object.entries(ACCORDS).map(([k, v]) => <option value={`accord:${k}`}>{v || 'Sans e-mail'}</option>)}</optgroup>
          <optgroup label="Suivi des ventes"><option value="pipeline:dans">Dans le suivi</option><option value="pipeline:hors">Hors suivi</option></optgroup>
          <optgroup label="État ambassadeur">{Object.entries(ETATS_AMBASSADEUR).map(([k, v]) => <option value={`ambassadeur_etat:${k}`}>{v}</option>)}</optgroup>
          <optgroup label="Autres"><option value="ambassadeur:oui">Ambassadeurs</option><option value="a_rappeler:oui">À rappeler</option></optgroup>
        </select>
      </div>
      <div class="ct-actifs"><span class="ct-pastilles" data-pastilles></span><span class="ct-total" data-compteur aria-live="polite">{total} contact{total > 1 ? 's' : ''} sur {total}</span></div>
      <div class="ct-lot" data-lot hidden>
        <strong data-lot-n aria-live="polite">0 sélectionné</strong>
        <select data-lot-action="categorie_id" aria-label="Changer la catégorie des contacts cochés"><option value="">Changer la catégorie…</option>{categories.map((c) => <option value={c.id}>{c.nom}</option>)}</select>
        <select data-lot-action="projet" aria-label="Changer le projet des contacts cochés"><option value="">Projet…</option>{Object.entries(PROJETS).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        <select data-lot-action="temperature" aria-label="Changer la température des contacts cochés"><option value="">Température…</option>{TEMPERATURES_CHOIX.map((k) => <option value={k}>{TEMPERATURES[k]}</option>)}<option value="aucune">Effacer la température</option></select>
        <button type="button" class="ct-btn" data-lot-verifie>Marquer vérifié</button>
        <button type="button" class="ct-btn" data-lot-modele>Envoyer un modèle</button>
        <button type="button" class="ct-btn" data-lot-ecarter>Écarter</button>
        <button type="button" class="ct-btn ct-lot-fin" data-lot-aucun>Désélectionner</button>
      </div>
      <div class="ct-boite">
        <table class="ct-table" data-tableau>
          <thead><tr data-entetes></tr></thead>
          <tbody data-lignes><tr><td class="ct-attente">Chargement des contacts…</td></tr></tbody>
        </table>
      </div>
      <noscript><p class="e-message">Le tableau a besoin de JavaScript. La liste des contacts suivis reste sur <a href="/contacts">/contacts</a>.</p></noscript>
    </div>
  </div>
  <dialog class="ct-dialogue" data-dialogue-vue aria-labelledby="ct-dialogue-titre">
    <form method="dialog" data-form-vue>
      <h2 id="ct-dialogue-titre" data-dialogue-titre>Nouvelle vue</h2>
      <p class="e-muet" data-dialogue-aide></p>
      <label class="ct-champ">Nom de la vue<input name="nom" maxlength="60" autocomplete="off" required /></label>
      <p class="ct-erreur" data-dialogue-erreur role="alert" hidden></p>
      <div class="ct-boutons"><button type="button" class="ct-btn" data-dialogue-annuler>Annuler</button><button type="submit" class="ct-btn bleu">Enregistrer</button></div>
    </form>
  </dialog>
  <dialog class="ct-dialogue" data-dialogue-modele aria-labelledby="ct-modele-titre">
    <form method="dialog" data-form-modele>
      <h2 id="ct-modele-titre">Envoyer un modèle</h2>
      <p class="e-muet" data-modele-intro></p>
      <label class="ct-champ">Modèle<select name="modele" data-modele-choix></select></label>
      <p class="e-muet">Vous relirez le message, vous vous enverrez un essai, puis vous confirmerez : rien ne part d'ici. Seuls les contacts avec accord ou anciens clients le reçoivent ; les autres sont écartés, avec la raison.</p>
      <p class="ct-erreur" data-modele-erreur role="alert" hidden></p>
      <div class="ct-boutons"><button type="button" class="ct-btn" data-modele-annuler>Annuler</button><button type="submit" class="ct-btn bleu">Préparer l'envoi</button></div>
    </form>
  </dialog>
  <dialog class="fc-panneau" data-fiche aria-labelledby="fc-titre"><div class="fc-corps" data-fiche-corps></div></dialog>
  <dialog class="ct-dialogue ct-creation" data-creation aria-labelledby="ct-creation-titre">
    <form data-form-creation novalidate>
      <h2 id="ct-creation-titre">Nouveau contact</h2>
      <p class="e-muet" data-creation-intro>Au moins un nom ou un téléphone. Le contact est créé vérifié, source « saisie à la main ».</p>
      <div class="fc-grille">
        <label class="ct-champ">Prénom<input name="prenom" maxlength="80" autocomplete="off" /></label>
        <label class="ct-champ">Nom<input name="nom" maxlength="80" autocomplete="off" /></label>
        <label class="ct-champ">Téléphone<input name="telephone" type="tel" maxlength="40" autocomplete="off" /></label>
        <label class="ct-champ">E-mail<input name="email" type="email" maxlength="254" autocomplete="off" /></label>
        <label class="ct-champ">Ville<input name="commune" maxlength="80" autocomplete="off" /></label>
        <label class="ct-champ">Entreprise<input name="entreprise" maxlength="120" autocomplete="off" /></label>
        <label class="ct-champ">Catégorie<select name="categorie_id">{categories.map((c) => <option value={c.id} selected={c.id === (categories.some((x) => x.id === 'proches') ? 'proches' : categories[0]?.id)}>{c.nom}</option>)}</select></label>
        <label class="ct-champ">Projet<select name="projet">{Object.entries(PROJETS).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
        <label class="ct-champ">Température<select name="temperature"></select></label>
      </div>
      <label class="ct-champ">Note<textarea name="note" rows="2" maxlength="2000"></textarea></label>
      <label class="fc-case"><input type="checkbox" name="accord" /> A accepté de recevoir les e-mails d'Anne</label>
      <p class="ct-erreur" data-creation-erreur role="alert" hidden></p>
      <div class="ct-boutons"><button type="button" class="ct-btn" data-creation-annuler>Annuler</button><button type="submit" class="ct-btn bleu">Enregistrer</button></div>
    </form>
  </dialog>
  <div class="ct-toast" data-toast role="status" hidden><span data-toast-texte></span><button type="button" data-toast-annuler hidden>Annuler</button></div>
  <script type="application/json" id="ct-donnees" set:html={donnees}></script>
  <script type="application/json" id="ct-reglages" set:html={reglages}></script>
  <script type="application/json" id="nv-donnees" set:html={donneesNouveaux}></script>
</Espace>

<script>
  // Îlot du tableau (AD-22) : tri, recherche (story 13.24), filtres et vues enregistrées (story 18.5, AD-27) et colonnes
  // masquées, tout dans le navigateur ; seules les vues s'écrivent, par /api/vues. Tout texte venu des données (noms de
  // contacts, de vues, de catégories, villes) passe par `esc` avant d'entrer dans le HTML, ou par textContent / value.
  import { telLisible } from '@site/server/recherche';
  import {
    ACCORDS, CANAUX_CONTACT, COLONNES, ETATS_AMBASSADEUR, PROJETS, PROJETS_AVEC_TEMPERATURE, TEMPERATURES, TEMPERATURES_CHOIX, indexer, etatAmbassadeur,
    libelleMois, libelleRencontres, libelleSource, preparerRecherche, temperaturePermise, valeurTri, type CleColonne, type LigneTableau,
  } from '../server/tableau-colonnes';
  import { ajouter, pastilles, preparerFiltre, retirer, type CleFiltre, type Filtre, type Vue } from '../server/vues';
  import { brancherFiche } from '../islands/fiche-contact';
  import { brancherNouveaux } from '../islands/nouveaux';

  const MEMOIRE = 'espace.contacts.colonnes';
  // Premier paquet de lignes écrit tout de suite, la suite par paquets aux images suivantes : le tableau répond vite même
  // avec des milliers de lignes (story 18.5 : chaque recherche ou filtre sous 300 ms avec 1 200 contacts).
  const PREMIER = 120, PAQUET = 400;
  const lignes: LigneTableau[] = JSON.parse(document.getElementById('ct-donnees')?.textContent || '[]');
  const reglages: { vues: Vue[]; categories: { id: string; nom: string }[] } = JSON.parse(document.getElementById('ct-reglages')?.textContent || '{"vues":[],"categories":[]}');
  // Calculé une seule fois : textes sans accents, numéros réduits aux chiffres, dates en millisecondes.
  const index = lignes.map(indexer);
  const dateDe = (l: LigneTableau) => l.dernier_le ? new Date(l.dernier_le).toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris' }) : '';
  const dates = lignes.map(dateDe);
  /** Story 18.11 : contacts supprimés depuis le chargement (« Ajouter aux contacts » annulé) : plus jamais affichés ni comptés. */
  const retires = new Set<string>();
  const actifs = () => lignes.filter((x) => !x.ecarte && !retires.has(x.id)).length;
  let total = actifs();
  const parId = new Map(lignes.map((l, i) => [l.id, i]));
  const nomsCategories = new Map(reglages.categories.map((c) => [c.id, c.nom]));
  let vues: Vue[] = reglages.vues;
  const comparer = new Intl.Collator('fr', { sensitivity: 'base', numeric: true }).compare;
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const recherche = $<HTMLInputElement>('[data-recherche]');
  const entetes = $<HTMLTableRowElement>('[data-entetes]');
  const corps = $<HTMLTableSectionElement>('[data-lignes]');
  const compteur = $<HTMLElement>('[data-compteur]');
  const menuColonnes = $<HTMLDetailsElement>('[data-colonnes]');
  const zoneVues = $<HTMLElement>('[data-vues]');
  const zoneCategories = $<HTMLElement>('[data-categories]');
  const zonePastilles = $<HTMLElement>('[data-pastilles]');
  const zoneFiltres = $<HTMLElement>('[data-filtres]');
  const entreprise = $<HTMLInputElement>('[data-filtre-texte=entreprise_contient]');
  const dialogue = $<HTMLDialogElement>('[data-dialogue-vue]');
  const formVue = $<HTMLFormElement>('[data-form-vue]');
  const erreurVue = $<HTMLElement>('[data-dialogue-erreur]');
  const toast = $<HTMLElement>('[data-toast]');
  const toastAnnuler = $<HTMLButtonElement>('[data-toast-annuler]');

  let cachees = new Set<CleColonne>();
  try { cachees = new Set(JSON.parse(localStorage.getItem(MEMOIRE) ?? '[]')); } catch {}
  // Ticket n° 233 : l'ordre des colonnes est gardé comme leur visibilité, dans ce navigateur (`localStorage`). Le nom reste en tête ;
  // une clé inconnue est ignorée et une colonne absente de la liste gardée (ajoutée plus tard) va à la fin.
  const MEMOIRE_ORDRE = 'espace.contacts.colonnes-ordre';
  const ordreDefaut = COLONNES.map((c) => c.cle);
  const ordreValide = (brut: unknown): CleColonne[] => {
    const lu = Array.isArray(brut) ? brut.filter((k): k is CleColonne => ordreDefaut.includes(k as CleColonne)) : [];
    const sans = [...new Set(lu)].filter((k) => k !== 'nom');
    return ['nom', ...sans, ...ordreDefaut.filter((k) => k !== 'nom' && !sans.includes(k))];
  };
  let ordre: CleColonne[] = ordreDefaut;
  try { ordre = ordreValide(JSON.parse(localStorage.getItem(MEMOIRE_ORDRE) ?? '[]')); } catch {}
  const colonnesVisibles = () => ordre.map((k) => COLONNES.find((c) => c.cle === k)!).filter((c) => !cachees.has(c.cle));
  let tri: { cle: CleColonne; sens: 1 | -1 } = { cle: 'nom', sens: 1 };
  let filtre: Filtre = {};
  /** La vue choisie (« tous », un identifiant), ou null quand les filtres ont changé depuis. */
  let vueActive: string | null = 'tous';
  const valeurs = new Map<CleColonne, (string | number | null)[]>();
  const valeursDe = (cle: CleColonne) => {
    let v = valeurs.get(cle);
    if (!v) { v = lignes.map((l) => valeurTri(l, cle)); valeurs.set(cle, v); }
    return v;
  };

  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const vide = '<span class="ct-vide">—</span>';
  const plus = (liste: string[], montrer: (v: string) => string) => liste.length > 1
    ? ` <span class="ct-plus" title="${esc(liste.slice(1).map(montrer).join(', '))}">+${liste.length - 1}</span>` : '';
  const pastille = (texte: string, classe = '') => `<span class="ct-pastille ${classe}">${esc(texte)}</span>`;
  const reseau = (r: string | null) => r ? ({ linkedin: 'LinkedIn', instagram: 'Instagram', facebook: 'Facebook' } as Record<string, string>)[r.toLowerCase()] ?? r : 'Profil';

  const nomDe = (l: LigneTableau) => [l.prenom, l.nom].filter(Boolean).join(' ') || telLisible(l.telephones[0]) || l.emails[0] || 'Sans nom';
  // Story 18.6 : catégorie, projet et température se changent dans la cellule (bouton ▾ qui devient une liste).
  const classer = (cle: string, contenu: string, titre: string) => `<button type="button" class="ct-classer" data-classer="${cle}" title="${esc(titre)}">${contenu}<span class="ct-chevron" aria-hidden="true">▾</span></button>`;

  function cellule(l: LigneTableau, i: number, cle: CleColonne): string {
    switch (cle) {
      case 'nom': return `<td class="ct-nom"><a href="/?fiche=${esc(l.id)}" data-ouvrir-fiche>${esc(nomDe(l))}</a></td>`;
      case 'entreprise': return `<td class="ct-coupe" title="${esc(l.entreprise)}">${l.entreprise ? esc(l.entreprise) : vide}</td>`;
      case 'categorie': return `<td>${classer('categorie_id', l.categorie ? pastille(l.categorie) : pastille('à ranger', 'aq'), 'Changer la catégorie')}</td>`;
      case 'projet': return `<td>${classer('projet', pastille(PROJETS[l.projet] ?? l.projet, l.projet === 'a_qualifier' ? 'aq' : ''), 'Changer le projet')}</td>`;
      case 'temperature': {
        const p = l.temperature ? pastille(TEMPERATURES[l.temperature] ?? l.temperature, `t-${esc(l.temperature)}`) : '';
        // Suivi des ventes en cours : la température suit l'étape (AD-24) ; projet sans température : rien à choisir.
        if (l.en_cours || !PROJETS_AVEC_TEMPERATURE.includes(l.projet)) return `<td>${p || vide}</td>`;
        return `<td>${classer('temperature', p || pastille('à préciser', 'aq'), 'Changer la température')}</td>`;
      }
      case 'sources': return `<td class="ct-src">${l.sources.length ? esc(l.sources.map(libelleSource).join(' + ')) : vide}</td>`;
      case 'rencontre': { const t = libelleRencontres(l.rencontres); return `<td class="ct-coupe" title="${esc(t)}">${t ? esc(t) : vide}</td>`; }
      case 'ville': return `<td>${l.ville ? esc(l.ville) : vide}</td>`;
      case 'telephone': return `<td class="ct-num">${l.telephones.length ? esc(telLisible(l.telephones[0])) + plus(l.telephones, telLisible) : vide}</td>`;
      case 'email': return `<td class="ct-coupe ct-mail" title="${esc(l.emails.join(', '))}">${l.emails.length ? esc(l.emails[0]) + plus(l.emails, (e) => e) : vide}</td>`;
      case 'profil': return `<td>${l.profils.length ? l.profils.map((p) => `<a href="${esc(p.url)}" target="_blank" rel="noopener noreferrer">${esc(reseau(p.reseau))}</a>`).join(' ') : vide}</td>`;
      case 'dernier': return `<td class="ct-num">${l.dernier_le ? `${esc(dates[i])}${l.dernier_canal ? ` · ${esc(CANAUX_CONTACT[l.dernier_canal] ?? l.dernier_canal)}` : ''}` : '<span class="ct-vide">jamais</span>'}</td>`;
      case 'accord': return `<td>${l.accord === 'sans_email' ? vide : `<span class="ct-accord ${esc(l.accord)}">${esc(ACCORDS[l.accord])}</span>`}</td>`;
      case 'ambassadeur': return `<td>${l.ambassadeur_etat ? `<span class="ct-pastille amb-${esc(l.ambassadeur_etat)}" data-ambassadeur="${esc(l.ambassadeur_etat)}">${esc(ETATS_AMBASSADEUR[l.ambassadeur_etat])}</span>` : vide}</td>`;
      case 'verifie': return `<td>${l.ecarte ? '<span class="ct-etat">écarté</span>' : l.verifie ? '<span class="ct-etat ok">✓ vérifié</span>' : '<span class="ct-etat av">à vérifier</span>'}</td>`;
      default: return '<td></td>';
    }
  }

  // Le HTML d'une ligne est gardé tant que les colonnes affichées ne changent pas : trier ou filtrer ne le recalcule pas.
  let html: (string | undefined)[] = [];
  let colonnes = colonnesVisibles();
  /** Les contacts cochés (identifiants) : gardés quand le tableau est redessiné (tri, filtres, recherche, paquets). */
  const coches = new Set<string>();
  const ligneHtml = (i: number) => {
    const l = lignes[i], on = coches.has(l.id);
    return html[i] ??= `<tr data-contact="${esc(l.id)}" data-i="${i}"${on ? ' class="ct-sel"' : ''}><td class="ct-case"><input type="checkbox" data-cocher aria-label="Cocher ${esc(nomDe(l))}"${on ? ' checked' : ''} /></td>${colonnes.map((c) => cellule(l, i, c.cle)).join('')}</tr>`;
  };

  /** Les lignes gardées par un filtre et une recherche (indices). */
  function garder(f: Filtre, q: string): number[] {
    const passe = preparerFiltre(f), cherche = preparerRecherche(q);
    const r: number[] = [];
    for (let i = 0; i < lignes.length; i++) if (!retires.has(lignes[i].id) && passe(lignes[i], index[i]) && cherche(index[i])) r.push(i);
    return r;
  }

  let generation = 0;
  /** Les lignes affichées (filtre et recherche), dans l'ordre du tableau : la plage de Maj + clic et « tout cocher ». */
  let affichees: number[] = [];
  function afficher() {
    entetes.innerHTML = '<th class="ct-case"><input type="checkbox" data-tout aria-label="Cocher toutes les lignes affichées" /></th>' + colonnes.map((c) => {
      const actif = tri.cle === c.cle;
      return `<th data-cle="${c.cle}" aria-sort="${actif ? (tri.sens === 1 ? 'ascending' : 'descending') : 'none'}"><button type="button" data-trier="${c.cle}">${esc(c.libelle)}<span class="ct-fleche" aria-hidden="true">${actif ? (tri.sens === 1 ? '▲' : '▼') : ''}</span></button></th>`;
    }).join('');
    // Revue de code 18.5 : une vue invalide (une catégorie a disparu…) ne garde aucun contact, et le dit.
    const garde = vueInvalide ? [] : garder(filtre, recherche.value);
    const v = valeursDe(tri.cle);
    garde.sort((a, b) => {
      const x = v[a], y = v[b];
      if (x === null || y === null) return x === y ? 0 : x === null ? 1 : -1; // vides en fin de liste, dans les deux sens
      const r = typeof x === 'number' && typeof y === 'number' ? x - y : comparer(String(x), String(y));
      return r * tri.sens;
    });
    affichees = garde;
    const g = ++generation;
    corps.removeAttribute('data-complet');
    corps.innerHTML = garde.length
      ? garde.slice(0, PREMIER).map(ligneHtml).join('')
      : `<tr><td class="ct-attente${vueInvalide ? ' ct-a-refaire' : ''}" colspan="${colonnes.length + 1}">${vueInvalide ? `Vue à refaire : ${esc(vueInvalide)}. Elle ne montre aucun contact tant que ses filtres ne sont pas choisis à nouveau.` : lignes.length ? 'Aucun contact pour ces filtres ou cette recherche.' : 'Aucun contact pour l\'instant.'}</td></tr>`;
    let n = PREMIER;
    const suite = () => {
      if (g !== generation) return;
      if (n >= garde.length) { corps.dataset.complet = '1'; return; }
      corps.insertAdjacentHTML('beforeend', garde.slice(n, n + PAQUET).map(ligneHtml).join(''));
      n += PAQUET;
      requestAnimationFrame(() => setTimeout(suite));
    };
    if (garde.length <= PREMIER) corps.dataset.complet = '1'; else requestAnimationFrame(() => setTimeout(suite));
    compteur.textContent = `${garde.length} contact${garde.length > 1 ? 's' : ''} sur ${total}`;
    afficherPastilles();
    marquerVue();
    majLot();
  }

  // Pastilles des filtres actifs : un clic en retire une. La recherche garde sa propre case.
  function afficherPastilles() {
    const p = pastilles(filtre, nomsCategories);
    zonePastilles.innerHTML = p.map((x) => `<button type="button" class="ct-chip" data-retirer="${esc(x.cle)}"${x.valeur === null ? '' : ` data-valeur="${esc(x.valeur)}"`} aria-label="Retirer le filtre ${esc(x.libelle)}">${esc(x.libelle)} <span aria-hidden="true">✕</span></button>`).join('')
      + (p.length > 1 ? '<button type="button" class="ct-chip ct-chip-tout" data-retirer-tout>Tout retirer</button>' : '');
    if (document.activeElement !== entreprise) entreprise.value = filtre.entreprise_contient ?? '';
  }

  // Colonne de gauche : « Tous les contacts », les vues (compteur sans la recherche), puis les catégories.
  let comptes = new Map<string, number>();
  const compterVues = () => { comptes = new Map(vues.map((v) => [v.id, v.invalide ? 0 : garder(v.filtre, v.filtre.recherche ?? '').length])); };
  function afficherVues() {
    zoneVues.innerHTML = `<div class="ct-vue-l"><button type="button" class="ct-vue" data-vue="tous"><span>Tous les contacts</span><small>${total}</small></button></div>`
      + vues.map((v) => `<div class="ct-vue-l"><button type="button" class="ct-vue${v.invalide ? ' ct-vue-invalide' : ''}" data-vue="${esc(v.id)}"${v.invalide ? ` title="Vue à refaire : ${esc(v.invalide)}"` : ''}><span>${v.invalide ? '<b aria-hidden="true">⚠</b> ' : ''}${esc(v.nom)}</span><small>${v.invalide ? 'à refaire' : comptes.get(v.id) ?? 0}</small></button>`
        + `<span class="ct-vue-gestes"><button type="button" class="ct-vue-x" data-renommer-vue="${esc(v.id)}" title="Renommer la vue" aria-label="Renommer la vue ${esc(v.nom)}">✎</button>`
        + `<button type="button" class="ct-vue-x" data-supprimer-vue="${esc(v.id)}" title="Supprimer la vue" aria-label="Supprimer la vue ${esc(v.nom)}">×</button></span></div>`).join('');
    const parCategorie = new Map<string, number>();
    for (const l of lignes) if (!l.ecarte && !retires.has(l.id) && l.categorie_id) parCategorie.set(l.categorie_id, (parCategorie.get(l.categorie_id) ?? 0) + 1);
    zoneCategories.innerHTML = reglages.categories.map((c) => `<button type="button" class="ct-vue" data-categorie="${esc(c.id)}"><span>${esc(c.nom)}</span><small>${parCategorie.get(c.id) ?? 0}</small></button>`).join('');
    marquerVue();
  }
  function marquerVue() {
    const sansFiltre = !Object.keys(filtre).length;
    const seuleCategorie = Object.keys(filtre).length === 1 && filtre.categorie_id?.length === 1 ? filtre.categorie_id[0] : null;
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-vue], [data-categorie]')) {
      const actif = b.dataset.vue ? (b.dataset.vue === 'tous' ? sansFiltre && vueActive !== null : b.dataset.vue === vueActive) : b.dataset.categorie === seuleCategorie && vueActive === null;
      b.classList.toggle('actif', actif);
      b.setAttribute('aria-pressed', String(actif));
    }
  }

  /** Le motif de la vue invalide choisie (revue de code 18.5), ou null. */
  let vueInvalide: string | null = null;
  const changerFiltre = (f: Filtre) => { filtre = f; vueActive = null; vueInvalide = null; afficher(); };

  // Choix des sources et des villes : celles des contacts chargés, dans l'ordre alphabétique.
  const remplir = (cle: string, valeursChoix: [string, string][]) => {
    $<HTMLSelectElement>(`[data-filtre=${cle}]`).insertAdjacentHTML('beforeend', valeursChoix.map(([v, t]) => `<option value="${esc(v)}">${esc(t)}</option>`).join(''));
  };
  remplir('source', [...new Set(lignes.flatMap((l) => l.sources))].map((s): [string, string] => [s, libelleSource(s)]).sort((a, b) => comparer(a[1], b[1])));
  const villes = new Map<string, string>();
  for (const l of lignes) { const v = l.ville?.trim(); if (v && !villes.has(v.toLowerCase())) villes.set(v.toLowerCase(), v); }
  remplir('ville', [...villes.values()].sort(comparer).map((v): [string, string] => [v, v]));
  // Story 18.17 : lieux et mois de rencontre présents en base (le mois le plus récent d'abord).
  const lieux = new Map<string, string>(), moisPresents = new Set<string>();
  for (const l of lignes) for (const r of l.rencontres) {
    if (r.lieu && !lieux.has(r.lieu.toLowerCase())) lieux.set(r.lieu.toLowerCase(), r.lieu);
    if (r.mois) moisPresents.add(r.mois);
  }
  remplir('lieu', [...lieux.values()].sort(comparer).map((v): [string, string] => [v, v]));
  remplir('mois', [...moisPresents].sort().reverse().map((m): [string, string] => [m, libelleMois(m)]));

  zoneFiltres.addEventListener('change', (e) => {
    const s = e.target as HTMLSelectElement;
    if (s.tagName !== 'SELECT' || !s.value) return;
    const [cle, valeur] = s.dataset.filtre === 'etat' || s.dataset.filtre === 'autres' ? s.value.split(':') : [s.dataset.filtre!, s.value];
    s.value = '';
    let f = filtre;
    if (cle === 'verifie' || cle === 'ecarte') f = retirer(retirer(f, 'verifie', null), 'ecarte', null); // un seul état à la fois
    changerFiltre(ajouter(f, cle as CleFiltre, cle === 'dernier_contact' && valeur !== 'jamais' ? Number(valeur) : valeur));
  });
  let attenteEntreprise: ReturnType<typeof setTimeout> | undefined;
  entreprise.addEventListener('input', () => {
    clearTimeout(attenteEntreprise);
    attenteEntreprise = setTimeout(() => {
      const v = entreprise.value.trim().slice(0, 80);
      changerFiltre(v ? ajouter(filtre, 'entreprise_contient', v) : retirer(filtre, 'entreprise_contient', null));
    }, 120);
  });
  zonePastilles.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-retirer], [data-retirer-tout]');
    if (!b) return;
    changerFiltre(b.dataset.retirer ? retirer(filtre, b.dataset.retirer as CleFiltre, b.dataset.valeur ?? null) : {});
  });
  zoneCategories.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-categorie]');
    if (b) changerFiltre({ categorie_id: [b.dataset.categorie!] });
  });

  // Vues : choisir, enregistrer, renommer, supprimer (et annuler la suppression tout de suite).
  async function appeler(methode: string, corpsJson?: unknown, id?: string): Promise<{ vue?: Vue; erreur?: string; status?: number }> {
    try {
      const r = await fetch(`/api/vues${id ? `?id=${encodeURIComponent(id)}` : ''}`, {
        method: methode, headers: corpsJson ? { 'Content-Type': 'application/json' } : {}, body: corpsJson ? JSON.stringify(corpsJson) : undefined,
      });
      const d = await r.json().catch(() => ({}));
      return r.ok ? d : { erreur: d.erreur ?? `Erreur ${r.status}`, status: r.status };
    } catch { return { erreur: 'Pas de connexion : réessayez.' }; }
  }
  let finToast: ReturnType<typeof setTimeout> | undefined;
  let annulation: (() => void) | null = null;
  function montrer(texte: string, annuler: (() => void) | null = null) {
    if (annuler !== annulerVue) supprimees.length = 0; // un autre message : les annulations de vues en attente expirent
    $<HTMLElement>('[data-toast-texte]').textContent = texte;
    annulation = annuler;
    toastAnnuler.hidden = !annuler;
    toast.hidden = false;
    clearTimeout(finToast);
    finToast = setTimeout(() => { toast.hidden = true; annulation = null; supprimees.length = 0; }, annuler ? 10000 : 4000);
  }
  // Revue de code 18.5 : une annulation par vue supprimée. « Annuler » remet la dernière supprimée, puis propose la précédente.
  const supprimees: Vue[] = [];
  async function annulerVue() {
    const v = supprimees.pop();
    if (!v) return;
    const x = await appeler('POST', { id: v.id, nom: v.nom, ordre: v.ordre, filtre: v.filtre });
    if (x.vue) { vues.push(x.vue); ranger(); }
    const suivante = supprimees[supprimees.length - 1];
    const fait = x.vue ? `Vue « ${x.vue.nom} » remise` : x.erreur ?? 'Erreur';
    if (suivante) montrer(`${fait}. Vue « ${suivante.nom} » supprimée`, annulerVue); else montrer(fait);
  }
  toastAnnuler.addEventListener('click', () => { const a = annulation; annulation = null; toast.hidden = true; a?.(); });
  // Ordres égaux départagés par l'identifiant, en ordre binaire comme la base (revue de code 18.5).
  const ranger = () => { vues.sort((a, b) => a.ordre - b.ordre || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)); compterVues(); afficherVues(); };

  let renommer: Vue | null = null;
  function ouvrirDialogue(titre: string, aide: string, nom: string, vue: Vue | null) {
    renommer = vue;
    $<HTMLElement>('[data-dialogue-titre]').textContent = titre;
    $<HTMLElement>('[data-dialogue-aide]').textContent = aide;
    formVue.nom.value = nom;
    erreurVue.hidden = true;
    dialogue.showModal();
    formVue.nom.select();
  }
  $<HTMLButtonElement>('[data-nouvelle-vue]').addEventListener('click', () => {
    const { recherche: _r, ...f } = filtre;
    if (!Object.keys(f).length) { montrer('Choisissez d\'abord des filtres au-dessus du tableau, puis enregistrez-les comme vue.'); return; }
    ouvrirDialogue('Nouvelle vue', `Filtres : ${pastilles(f, nomsCategories).map((p) => p.libelle).join(' · ')}. La recherche n'est pas enregistrée.`, '', null);
  });
  $<HTMLButtonElement>('[data-dialogue-annuler]').addEventListener('click', () => dialogue.close());
  formVue.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nom = String(formVue.nom.value).trim();
    if (!nom) return;
    const { recherche: _r, ...f } = filtre;
    // Revue de code 18.5 : « Enregistrer » désactivé pendant l'appel (un double clic ne crée pas deux vues).
    const bouton = formVue.querySelector<HTMLButtonElement>('button[type=submit]')!;
    if (bouton.disabled) return;
    bouton.disabled = true;
    const r = renommer ? await appeler('PATCH', { id: renommer.id, nom }) : await appeler('POST', { nom, filtre: f });
    bouton.disabled = false;
    if (!r.vue) { erreurVue.textContent = r.erreur ?? 'Erreur'; erreurVue.hidden = false; return; }
    dialogue.close();
    if (renommer) {
      const v = vues.find((x) => x.id === r.vue!.id);
      if (v) v.nom = r.vue.nom;
      afficherVues();
      montrer(`Vue renommée « ${r.vue.nom} »`);
    } else {
      vues.push(r.vue);
      vueActive = r.vue.id;
      ranger();
      montrer(`Vue « ${r.vue.nom} » enregistrée`);
    }
  });
  zoneVues.addEventListener('click', async (e) => {
    const cible = e.target as Element;
    const ren = cible.closest<HTMLElement>('[data-renommer-vue]'), sup = cible.closest<HTMLElement>('[data-supprimer-vue]');
    if (ren) {
      const v = vues.find((x) => x.id === ren.dataset.renommerVue);
      if (v) ouvrirDialogue('Renommer la vue', 'Les filtres de la vue ne changent pas.', v.nom, v);
      return;
    }
    if (sup) {
      // Revue de code 18.5 : bouton désactivé pendant l'appel ; une vue déjà retirée (404) part sans message d'erreur.
      if ((sup as HTMLButtonElement).disabled) return;
      (sup as HTMLButtonElement).disabled = true;
      const id = sup.dataset.supprimerVue!;
      const r = await appeler('DELETE', undefined, id);
      (sup as HTMLButtonElement).disabled = false;
      if (!r.vue && r.status !== 404) { montrer(r.erreur ?? 'Erreur'); return; }
      vues = vues.filter((x) => x.id !== id);
      if (vueActive === id) { vueActive = null; vueInvalide = null; }
      ranger();
      afficher();
      if (!r.vue) return;
      supprimees.push(r.vue);
      montrer(`Vue « ${r.vue.nom} » supprimée`, annulerVue);
      return;
    }
    const b = cible.closest<HTMLElement>('[data-vue]');
    if (!b) return;
    const v = vues.find((x) => x.id === b.dataset.vue);
    const { recherche: q, ...f } = v?.filtre ?? {};
    clearTimeout(attenteEntreprise); // revue de code 18.5 : une frappe en attente dans « Entreprise contient » ne vient pas changer la vue
    filtre = f;
    if (q) recherche.value = q;
    vueActive = v ? v.id : 'tous';
    vueInvalide = v?.invalide ?? null;
    afficher();
  });

  entetes.addEventListener('click', (e) => {
    const cle = (e.target as Element).closest<HTMLElement>('[data-trier]')?.dataset.trier as CleColonne | undefined;
    if (!cle) return;
    tri = tri.cle === cle ? { cle, sens: tri.sens === 1 ? -1 : 1 } : { cle, sens: 1 };
    afficher();
  });
  // Le tableau se recalcule 120 ms après la dernière frappe, pas à chaque lettre (revue de code 18.4).
  let attente: ReturnType<typeof setTimeout> | undefined;
  recherche.addEventListener('input', () => { clearTimeout(attente); attente = setTimeout(afficher, 120); });
  for (const boite of menuColonnes.querySelectorAll<HTMLInputElement>('input[type=checkbox]')) {
    boite.checked = !cachees.has(boite.value as CleColonne);
    boite.addEventListener('change', () => {
      if (boite.checked) cachees.delete(boite.value as CleColonne); else cachees.add(boite.value as CleColonne);
      try { localStorage.setItem(MEMOIRE, JSON.stringify([...cachees])); } catch {}
      colonnes = colonnesVisibles();
      html = [];
      afficher();
    });
  }
  // Flèches monter / descendre : le menu se réordonne, puis le tableau (le nom, premier, ne bouge pas).
  const listeColonnes = menuColonnes.querySelector<HTMLElement>('[data-colonnes-liste]')!;
  const rangerMenu = () => {
    for (const k of ordre) { const ligne = listeColonnes.querySelector(`[data-col="${k}"]`); if (ligne) listeColonnes.append(ligne); }
    const lignes = [...listeColonnes.querySelectorAll<HTMLElement>('[data-col]')];
    lignes.forEach((l, i) => {
      l.querySelector<HTMLButtonElement>('[data-monter]')!.disabled = i === 0;
      l.querySelector<HTMLButtonElement>('[data-descendre]')!.disabled = i === lignes.length - 1;
    });
  };
  rangerMenu();
  listeColonnes.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-monter], [data-descendre]');
    const cle = b?.closest<HTMLElement>('[data-col]')?.dataset.col as CleColonne | undefined;
    if (!b || !cle) return;
    const i = ordre.indexOf(cle), j = i + (b.hasAttribute('data-monter') ? -1 : 1);
    if (j < 1 || j >= ordre.length) return; // le nom (rang 0) ne bouge pas, rien ne passe devant lui
    [ordre[i], ordre[j]] = [ordre[j], ordre[i]];
    try { localStorage.setItem(MEMOIRE_ORDRE, JSON.stringify(ordre)); } catch {}
    colonnes = colonnesVisibles();
    html = [];
    rangerMenu();
    afficher();
    listeColonnes.querySelector<HTMLButtonElement>(`[data-col="${cle}"] ${b.hasAttribute('data-monter') ? '[data-monter]' : '[data-descendre]'}`)?.focus();
  });
  // Story 18.6 : cases à cocher, actions groupées et classement d'une seule ligne (FR-4, FR-5). Écritures par /api/carnet.
  const barreLot = $<HTMLElement>('[data-lot]');
  const lotN = $<HTMLElement>('[data-lot-n]');
  const boutonEcarter = $<HTMLButtonElement>('[data-lot-ecarter]');
  /** Dernière case cliquée (indice de ligne), départ de la plage de Maj + clic. */
  let derniere: number | null = null;
  /** Remet les cases et le surlignage des lignes déjà écrites d'après `coches`, en un seul passage. */
  function peindreCoches() {
    for (const tr of corps.querySelectorAll<HTMLTableRowElement>('tr[data-i]')) {
      const on = coches.has(lignes[Number(tr.dataset.i)].id);
      tr.classList.toggle('ct-sel', on);
      const c = tr.querySelector<HTMLInputElement>('input[data-cocher]');
      if (c) c.checked = on;
    }
    majLot();
  }
  function cocher(indices: number[], on: boolean) {
    for (const i of indices) { if (on) coches.add(lignes[i].id); else coches.delete(lignes[i].id); html[i] = undefined; }
    peindreCoches();
  }
  function majLot() {
    let vus = 0;
    for (const i of affichees) if (coches.has(lignes[i].id)) vus++;
    const tout = entetes.querySelector<HTMLInputElement>('[data-tout]');
    if (tout) { tout.checked = affichees.length > 0 && vus === affichees.length; tout.indeterminate = vus > 0 && vus < affichees.length; }
    barreLot.hidden = coches.size === 0;
    const n = coches.size, caches = n - vus;
    lotN.textContent = `${n} sélectionné${n > 1 ? 's' : ''}${caches ? ` (dont ${caches} hors de l'affichage)` : ''}`;
    boutonEcarter.textContent = filtre.ecarte === 'oui' ? 'Faire revenir' : 'Écarter';
  }
  entetes.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-tout]')) cocher(affichees, t.checked);
  });

  type Changements = { categorie_id?: string; projet?: string; temperature?: string | null; verifie?: boolean; ecarte?: boolean };
  type LigneClassee = Pick<LigneTableau, 'id' | 'categorie_id' | 'categorie' | 'projet' | 'temperature' | 'verifie' | 'ecarte'>;
  type Reponse = { ok: boolean; error?: { message: string }; lot?: string | null; touches?: number; ignores?: number; inchanges?: number; rendus?: number; gardes?: number; lignes?: LigneClassee[] };
  async function carnet(corpsJson: unknown): Promise<Reponse> {
    try {
      const r = await fetch('/api/carnet', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpsJson) });
      const d = await r.json().catch(() => ({}));
      return r.ok ? d : { ok: false, error: { message: d.error?.message ?? `Erreur ${r.status}` } };
    } catch { return { ok: false, error: { message: 'Pas de connexion : réessayez.' } }; }
  }
  /** Reporte dans le tableau les lignes renvoyées par le serveur, sans recharger : compteurs, vues et catégories suivent. */
  function reporter(l: LigneClassee[] = []) {
    for (const x of l) {
      const i = parId.get(x.id);
      if (i === undefined) continue;
      Object.assign(lignes[i], { categorie_id: x.categorie_id, categorie: x.categorie, projet: x.projet, temperature: x.temperature, verifie: x.verifie, ecarte: x.ecarte });
      lignes[i].ambassadeur_etat = etatAmbassadeur(x.projet, lignes[i].ambassadeur_inscrit, lignes[i].ambassadeur_contacte);
      html[i] = undefined;
    }
    valeurs.clear();
    total = actifs();
    compterVues();
    afficherVues();
    afficher();
  }
  const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
  let enCours = false;
  /** Envoie un classement, met le tableau à jour, annonce le nombre de contacts touchés et propose d'annuler. */
  async function envoyer(ids: string[], ch: Changements, detail: string) {
    if (enCours || !ids.length) return false;
    enCours = true;
    barreLot.querySelectorAll<HTMLButtonElement | HTMLSelectElement>('button, select').forEach((b) => { b.disabled = true; });
    const r = await carnet({ ids, changements: ch });
    enCours = false;
    barreLot.querySelectorAll<HTMLButtonElement | HTMLSelectElement>('button, select').forEach((b) => { b.disabled = false; });
    if (!r.ok) { montrer(r.error?.message ?? 'Erreur'); return false; }
    reporter(r.lignes);
    const n = r.touches ?? 0, ign = r.ignores ?? 0;
    const texte = `${pluriel(n, 'contact')} touché${n > 1 ? 's' : ''}${n ? ` : ${detail}` : ''}`
      + (ign ? ` (${pluriel(ign, 'ignoré')} : pas de température pour leur projet, ou fixée par le suivi des ventes)` : '');
    const lot = r.lot;
    montrer(texte, lot ? async () => {
      const a = await carnet({ annuler: lot });
      if (!a.ok) { montrer(a.error?.message ?? 'Erreur'); return; }
      reporter(a.lignes);
      montrer(`${pluriel(a.rendus ?? 0, 'contact')} remis comme avant${a.gardes ? ` ; ${pluriel(a.gardes, 'contact')} modifié${(a.gardes ?? 0) > 1 ? 's' : ''} depuis, gardé${(a.gardes ?? 0) > 1 ? 's' : ''} tel${(a.gardes ?? 0) > 1 ? 's' : ''} quel${(a.gardes ?? 0) > 1 ? 's' : ''}` : ''}`);
    } : null);
    return true;
  }
  const libelleChangement = (cle: string, v: string) => cle === 'categorie_id' ? `rangé dans « ${nomsCategories.get(v) ?? v} », vérifié`
    : cle === 'projet' ? `projet « ${PROJETS[v] ?? v} »${PROJETS_AVEC_TEMPERATURE.includes(v) ? '' : ', température effacée'}`
    : v === 'aucune' ? 'température effacée' : `température « ${TEMPERATURES[v] ?? v} »`;
  /** Une action groupée : sur tous les contacts cochés ; les cases se vident si elle réussit. */
  async function lot(ch: Changements, detail: string) {
    if (await envoyer([...coches], ch, detail)) { coches.clear(); html = []; derniere = null; afficher(); }
  }
  /**
   * Revue de code 18.6 : une liste n'écrit qu'au choix confirmé, d'un clic dans la liste ouverte ou par Entrée. Sur une liste
   * fermée, les flèches (ou une lettre) du clavier changent la valeur affichée à chaque touche et le navigateur envoie
   * aussitôt « change » : sans cette garde, une seule flèche classerait tous les contacts cochés.
   */
  function surChoix(s: HTMLSelectElement, appliquer: (v: string) => void, abandon: () => void, vide = false) {
    let clavier = false;
    const valider = () => { clavier = false; const v = s.value; if (v || vide) appliquer(v); };
    s.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); valider(); return; }
      if (e.key === 'Escape') { clavier = false; abandon(); return; }
      if (e.key !== 'Tab' && e.key !== ' ' && !e.altKey && !e.ctrlKey && !e.metaKey) clavier = true;
    });
    s.addEventListener('pointerdown', () => { clavier = false; });
    s.addEventListener('change', () => { if (!clavier) valider(); });
    s.addEventListener('blur', () => { if (clavier) { clavier = false; abandon(); } });
  }
  for (const s of barreLot.querySelectorAll<HTMLSelectElement>('select[data-lot-action]')) {
    const cle = s.dataset.lotAction!;
    surChoix(s, (v) => {
      s.value = '';
      void lot(cle === 'temperature' ? { temperature: v === 'aucune' ? null : v } : { [cle]: v }, libelleChangement(cle, v));
    }, () => { s.value = ''; });
  }
  $<HTMLButtonElement>('[data-lot-verifie]').addEventListener('click', () => void lot({ verifie: true }, 'marqués vérifiés'));
  boutonEcarter.addEventListener('click', () => {
    const revenir = filtre.ecarte === 'oui';
    void lot({ ecarte: !revenir }, revenir ? 'revenus dans le tableau' : 'écartés (filtre « Écartés » pour les revoir)');
  });
  // Story 18.18 : « Envoyer un modèle » aux contacts cochés. Crée un brouillon de campagne (jamais d'envoi d'ici) puis ouvre sa page.
  const dialogueModele = $<HTMLDialogElement>('[data-dialogue-modele]');
  const formModele = $<HTMLFormElement>('[data-form-modele]');
  const erreurModele = $<HTMLElement>('[data-modele-erreur]');
  $<HTMLButtonElement>('[data-lot-modele]').addEventListener('click', async () => {
    erreurModele.hidden = true;
    $<HTMLElement>('[data-modele-intro]').textContent = `${pluriel(coches.size, 'contact coché')} : le message sera préparé pour eux.`;
    const choix = $<HTMLSelectElement>('[data-modele-choix]');
    choix.innerHTML = '<option value="">Chargement…</option>';
    dialogueModele.showModal();
    try {
      const r = await fetch('/api/campagnes?modeles=1');
      const d = await r.json() as { modeles?: { id: string; nom: string; objet: string }[] };
      const l = d.modeles ?? [];
      choix.innerHTML = (l.length ? '' : '<option value="">Aucun modèle</option>') + '<option value="">Un message à écrire moi-même</option>' + l.map((m) => `<option value="${esc(m.id)}">${esc(m.nom)}${m.objet ? ` : ${esc(m.objet)}` : ''}</option>`).join('');
      if (l.length) choix.value = l[0].id;
    } catch { choix.innerHTML = '<option value="">Un message à écrire moi-même</option>'; }
  });
  $<HTMLButtonElement>('[data-modele-annuler]').addEventListener('click', () => dialogueModele.close());
  formModele.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = formModele.querySelector<HTMLButtonElement>('button[type=submit]')!;
    if (bouton.disabled || !coches.size) return;
    bouton.disabled = true;
    try {
      const modele = String(new FormData(formModele).get('modele') ?? '');
      const r = await fetch('/api/campagnes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ids: [...coches], ...(modele ? { modele } : {}) }) });
      const d = await r.json().catch(() => ({})) as { id?: string; error?: { message: string } };
      if (r.ok && d.id) { location.href = `/campagnes?id=${d.id}`; return; }
      erreurModele.textContent = d.error?.message ?? `Erreur ${r.status}`; erreurModele.hidden = false;
    } catch { erreurModele.textContent = 'Pas de connexion : réessayez.'; erreurModele.hidden = false; }
    bouton.disabled = false;
  });
  $<HTMLButtonElement>('[data-lot-aucun]').addEventListener('click', () => { coches.clear(); html = []; derniere = null; peindreCoches(); });

  // Une seule ligne : le bouton ▾ de la cellule devient une petite liste ; choisir écrit tout de suite.
  function ouvrirListe(b: HTMLElement, i: number) {
    const l = lignes[i], cle = b.dataset.classer!;
    const options: [string, string][] = cle === 'categorie_id' ? reglages.categories.map((c) => [c.id, c.nom])
      : cle === 'projet' ? Object.entries(PROJETS)
      : [['', 'à préciser'], ...TEMPERATURES_CHOIX.filter((t) => temperaturePermise(t, l.projet)).map((t): [string, string] => [t, TEMPERATURES[t]])];
    const actuelle = cle === 'categorie_id' ? l.categorie_id : cle === 'projet' ? l.projet : l.temperature ?? '';
    const s = document.createElement('select');
    s.className = 'ct-liste';
    s.dataset.liste = cle;
    s.setAttribute('aria-label', `${cle === 'categorie_id' ? 'Catégorie' : cle === 'projet' ? 'Projet' : 'Température'} de ${nomDe(l)}`);
    s.innerHTML = (cle === 'categorie_id' && !l.categorie_id ? '<option value="" selected disabled>Choisir…</option>' : '')
      + options.map(([v, t]) => `<option value="${esc(v)}"${v === actuelle ? ' selected' : ''}>${esc(t)}</option>`).join('');
    b.replaceWith(s);
    s.focus();
    // Story 18.15 (ticket 238) : un seul clic ; le clic de la pastille donne l'activation que showPicker exige. Sans
    // support (ou refusé), la liste garde le focus comme avant.
    try { s.showPicker(); } catch {}
    let fini = false;
    const refermer = () => { if (fini) return; fini = true; const tr = s.closest('tr'); if (tr) tr.outerHTML = ligneHtml(i); };
    // Revue de code 18.6 : écrit au clic dans la liste ouverte ou par Entrée, jamais à chaque flèche du clavier (`surChoix`).
    const choisir = async () => {
      if (fini) return;
      fini = true;
      const v = s.value;
      s.disabled = true;
      const ch: Changements = cle === 'temperature' ? { temperature: v || null } : { [cle]: v };
      const ok = await envoyer([l.id], ch, `${nomDe(l)}, ${cle === 'temperature' && !v ? 'température effacée' : libelleChangement(cle, v)}`);
      if (!ok) { fini = false; refermer(); }
    };
    // « À préciser » (température vide) se choisit aussi.
    surChoix(s, () => void choisir(), () => refermer(), cle === 'temperature');
    s.addEventListener('blur', () => setTimeout(refermer, 150));
  }

  corps.addEventListener('click', (e) => {
    const cible = e.target as HTMLElement;
    const tr = cible.closest<HTMLTableRowElement>('tr[data-i]');
    if (!tr) return;
    const i = Number(tr.dataset.i);
    if (cible.matches('input[data-cocher]')) {
      const on = (cible as HTMLInputElement).checked;
      const a = derniere === null ? -1 : affichees.indexOf(derniere), b = affichees.indexOf(i);
      // Maj + clic : toute la plage entre la case cliquée juste avant et celle-ci, dans l'ordre affiché (FR-4).
      cocher(e.shiftKey && a >= 0 && b >= 0 ? affichees.slice(Math.min(a, b), Math.max(a, b) + 1) : [i], on);
      derniere = i;
      return;
    }
    const b = cible.closest<HTMLElement>('[data-classer]');
    if (b) { ouvrirListe(b, i); return; }
    // Story 18.7 : le nom ouvre la fiche dans le panneau (Ctrl ou Cmd + clic : dans un nouvel onglet, fiche ouverte).
    const a = cible.closest<HTMLAnchorElement>('[data-ouvrir-fiche]');
    if (a && !e.ctrlKey && !e.metaKey && !e.shiftKey && e.button === 0) { e.preventDefault(); void fiches.ouvrirFiche(lignes[i].id); }
  });
  /** Une ligne écrite par la fiche ou la création (story 18.7) : remplacée, ou ajoutée au tableau, sans recharger. */
  function remettreLigne(l: LigneTableau) {
    let i = parId.get(l.id);
    retires.delete(l.id);
    if (i === undefined) { i = lignes.length; lignes.push(l); index.push(indexer(l)); dates.push(dateDe(l)); parId.set(l.id, i); }
    else { lignes[i] = l; index[i] = indexer(l); dates[i] = dateDe(l); }
    html[i] = undefined;
    valeurs.clear();
    total = actifs();
    compterVues();
    afficherVues();
    afficher();
  }
  const fiches = brancherFiche({ categories: reglages.categories, surLigne: remettreLigne, annoncer: (t) => montrer(t) });
  /** Un contact qui n'existe plus (création annulée depuis la barre « Nouveaux ») sort du tableau sans recharger. */
  function retirerLigne(id: string) {
    retires.add(id);
    coches.delete(id);
    valeurs.clear();
    total = actifs();
    compterVues();
    afficherVues();
    afficher();
  }
  brancherNouveaux({ fiches, surLigne: remettreLigne, retirer: retirerLigne, montrer });
  $<HTMLButtonElement>('[data-nouveau-contact]').addEventListener('click', () => fiches.ouvrirCreation());
  const ficheDemandee = new URL(location.href).searchParams.get('fiche');
  if (ficheDemandee && /^[0-9A-HJKMNP-TV-Z]{26}$/.test(ficheDemandee)) void fiches.ouvrirFiche(ficheDemandee);
  document.addEventListener('click', (e) => { if (!menuColonnes.contains(e.target as Node)) menuColonnes.open = false; });
  compterVues();
  afficherVues();
  afficher();
</script>

<style is:global>
